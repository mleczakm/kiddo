FROM php:8.5-cli-alpine AS base

WORKDIR /app
ENV APP_ENV=prod
ENV APP_RUNTIME_MODE="web=1&worker=1"
EXPOSE 9501

CMD bin/console swoole:server:run

# io_uring is unavailable inside the production LXC guest even on a new-enough
# host kernel. Compile Swoole without it so coroutine mode uses epoll instead.
ENV IPE_SWOOLE_WITHOUT_IOURING=1

RUN --mount=type=bind,from=mlocati/php-extension-installer:latest,source=/usr/bin/install-php-extensions,target=/usr/local/bin/install-php-extensions \
    install-php-extensions apcu curl ds-^1 ffi intl pcntl pdo_pgsql sysvsem swoole-6.2.2 xsl zip

COPY .docker/php/ini/zz-php.ini /usr/local/etc/php/conf.d/zz-php.ini

FROM base AS dev-local

ENV APP_ENV=dev

RUN --mount=type=bind,from=mlocati/php-extension-installer:latest,source=/usr/bin/install-php-extensions,target=/usr/local/bin/install-php-extensions \
    install-php-extensions @composer xdebug

FROM dev-local AS dev

COPY composer.json composer.lock ./

RUN composer install --prefer-dist --no-scripts --no-interaction --no-progress --no-cache --optimize-autoloader

COPY assets/ assets/
COPY bin/ bin/
COPY config/ config/
COPY migrations/ migrations/
COPY public/ public/
COPY src/ src/
COPY templates/ templates/
COPY tests/ tests/
COPY translations/ translations/
COPY .env .env.test ecs.php importmap.php phpstan.dist.neon phpstan-baseline.neon phpunit.xml.dist rector.php ./


# cache:warmup can crash the first time it runs in a clean container: swoole-bundle's Opcache
# blacklist (see zz-php.ini) is itself generated by this same command, so the first run has
# nothing to blacklist yet and can segfault populating it. Once it exists, the retry succeeds.
RUN (bin/console cache:warmup || bin/console cache:warmup) \
    && bin/console tailwind:build --minify  \
    && bin/console importmap:install \
    && bin/console asset-map:compile \
    && bin/console assets:install --symlink \
    && rm -rf var/tailwind

FROM base AS prod

# -f/--fail is required: without it, curl only fails the healthcheck on a transport-level
# error (connection refused, timeout) and treats any HTTP response - including a 500 or the
# 503 symfony_health_check.yaml now sends for a failed check - as success (exit 0). Confirmed
# directly: `curl -sS` against a 500 response exits 0.
HEALTHCHECK --start-period=2s --interval=5s --timeout=5s --retries=5 CMD curl -sSf localhost:9501/health || exit 1

COPY composer.json composer.lock ./

RUN --mount=type=bind,from=composer/composer:2-bin,source=/composer,target=/usr/bin/composer \
    composer install --prefer-dist --no-scripts --no-interaction --no-progress --no-cache --optimize-autoloader --no-dev

COPY assets/ assets/
COPY bin/ bin/
COPY config/ config/
COPY migrations/ migrations/
COPY public/ public/
COPY src/ src/
COPY templates/ templates/
COPY translations/ translations/
COPY .env .env.prod importmap.php ./

# Set after composer install so tag/sha changes do not bust the vendor layer.
# Must be before cache:warmup — prod config requires APP_VERSION / APP_REVISION.
ARG APP_VERSION
ARG APP_REVISION
ENV APP_VERSION=${APP_VERSION}
ENV APP_REVISION=${APP_REVISION}

# cache:warmup can crash the first time it runs in a clean container: swoole-bundle's Opcache
# blacklist (see zz-php.ini) is itself generated by this same command, so the first run has
# nothing to blacklist yet and can segfault populating it. Once it exists, the retry succeeds.
RUN (bin/console cache:warmup || bin/console cache:warmup) \
    && bin/console tailwind:build --minify  \
    && bin/console importmap:install \
    && bin/console asset-map:compile \
    && bin/console assets:install --symlink \
    && rm -rf var/tailwind
