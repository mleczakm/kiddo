{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "name": "mleczakm/kiddo",
  "description": "App for bookings",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/symfony-swoole/swoole-bundle.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/mleczakm/z-engine.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/mleczakm/feature-flag-bundle.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/mleczakm/zip-bomb-honeypot.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/mleczakm/twig-now.git"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-ds": "*",
    "ext-iconv": "*",
    "ext-swoole": "*",
    "ext-zlib": "*",
    "bgalati/monolog-sentry-handler": "^2.1",
    "brick/money": "^0.10.3",
    "carbonphp/carbon-doctrine-types": "^3.0",
    "directorytree/imapengine": "^1.25.4",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.6.7",
    "dragonmantank/cron-expression": "^3.6",
    "dunglas/doctrine-json-odm": "^1.5.0",
    "gedmo/doctrine-extensions": "^3.22.1",
    "macpaw/symfony-health-check-bundle": "^2.0",
    "martin-georgiev/postgresql-for-doctrine": "^3.7.0",
    "mleczakm/twig-now": "^0.1.0",
    "mleczakm/zip-bomb-honeypot": "^1.0",
    "novaway/feature-flag-bundle": "dev-master#2279289d1ac26bc6289256c8210b0ec97c8ef0eb as 3.0.2",
    "nyholm/psr7": "^1.8.2",
    "odolbeau/phone-number-bundle": "^4.2.5",
    "phpdocumentor/reflection-docblock": "^5.6.7",
    "scienta/doctrine-json-functions": "^6.5",
    "sentry/sentry-symfony": "^5.11.0",
    "swoole-bundle/resetter-bundle": "^2.0",
    "swoole-bundle/swoole-bundle": "dev-develop#305af93f9853cf9540c473a4b62429b2c5b9c91c",
    "swoole-bundle/z-engine": "dev-fix/get-raw-class-alias-ptr#707487f2f9b9611d3099cc35e8d74e5c8ea05a88 as 8.5.1",
    "symfony/asset": "8.0.*",
    "symfony/asset-mapper": "8.0.*",
    "symfony/brevo-mailer": "8.0.*",
    "symfony/console": "8.0.*",
    "symfony/dependency-injection": "8.1.*",
    "symfony/doctrine-messenger": "8.0.*",
    "symfony/dotenv": "8.0.*",
    "symfony/event-dispatcher": "8.0.*",
    "symfony/expression-language": "8.0.*",
    "symfony/flex": "^2.11.0",
    "symfony/form": "8.0.*",
    "symfony/framework-bundle": "8.0.*",
    "symfony/http-client": "8.0.*",
    "symfony/http-kernel": "8.1.*",
    "symfony/intl": "8.0.*",
    "symfony/lock": "8.0.*",
    "symfony/mailer": "8.0.*",
    "symfony/mcp-bundle": "^0.12.0",
    "symfony/mime": "8.0.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/notifier": "8.0.*",
    "symfony/process": "8.0.*",
    "symfony/property-access": "8.0.*",
    "symfony/property-info": "8.0.*",
    "symfony/rate-limiter": "8.0.*",
    "symfony/runtime": "8.0.*",
    "symfony/scheduler": "8.0.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-http": "8.1.*",
    "symfony/serializer": "8.0.*",
    "symfony/stimulus-bundle": "^2.36.0",
    "symfony/string": "8.0.*",
    "symfony/translation": "8.0.*",
    "symfony/twig-bundle": "8.0.*",
    "symfony/uid": "8.0.*",
    "symfony/ux-dropzone": "^3.4",
    "symfony/ux-live-component": "^2.36.0",
    "symfony/ux-turbo": "^2.36.0",
    "symfony/validator": "8.0.*",
    "symfony/var-dumper": "8.1.*",
    "symfony/var-exporter": "8.1.*",
    "symfony/web-link": "8.0.*",
    "symfony/workflow": "8.0.*",
    "symfony/yaml": "8.0.*",
    "symfonycasts/tailwind-bundle": "^1.0",
    "tales-from-a-dev/flowbite-bundle": "^1.0",
    "twig/cssinliner-extra": "^3.26",
    "twig/extra-bundle": "^3.24.0",
    "twig/inky-extra": "^3.26",
    "twig/intl-extra": "^3.26.0",
    "twig/twig": "^3.28.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true,
    "platform": {
      "ext-xsl": "0.8.23"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "qa": {
      "Static analysis": "@sa",
      "Tests": "@tests"
    },
    "sa": {
      "Validate composer.json": "@composer validate",
      "Security audit": "@composer audit",
      "lint:twig": "bin/console lint:twig src templates",
      "Mago lint": "mago lint",
      "Mago analyze": "mago analyze",
      "Mago format": "mago format --check"
    },
    "tests": {
      "Unit tests": "bin/phpunit --group unit",
      "Smoke": "@tests:smoke",
      "Functional": "@tests:functional"
    },
    "tests:smoke": {
      "Setup": "@tests:functional:setup",
      "Smoke tests": "bin/phpunit --group smoke"
    },
    "tests:functional": {
      "Disable timeout": "Composer\\Config::disableProcessTimeout",
      "Setup": "@tests:functional:setup",
      "Functional tests": "bin/phpunit --group functional"
    },
    "tests:functional:setup": {
      "Functional tests setup": "bin/console doctrine:database:create --if-not-exists --env=test",
      "Functional tests schema": "bin/console doctrine:migrations:migrate --no-interaction --env=test"
    },
    "qa:fix": [
      "@sa:fix"
    ],
    "sa:fix": {
      "Disable timeout": "Composer\\Config::disableProcessTimeout",
      "Mago lint fix": "mago lint --fix",
      "Mago format": "mago format"
    }
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.0.*"
    },
    "violinist": {
      "number_of_concurrent_updates": 2,
      "one_pull_request_per_package": 1,
      "bundled_packages": {
        "symfony/framework-bundle": [
          "symfony/asset",
          "symfony/asset-mapper",
          "symfony/brevo-mailer",
          "symfony/browser-kit",
          "symfony/console",
          "symfony/css-selector",
          "symfony/debug-bundle",
          "symfony/doctrine-messenger",
          "symfony/dotenv",
          "symfony/event-dispatcher",
          "symfony/expression-language",
          "symfony/form",
          "symfony/framework-bundle",
          "symfony/http-client",
          "symfony/intl",
          "symfony/lock",
          "symfony/mailer",
          "symfony/maker-bundle",
          "symfony/mime",
          "symfony/monolog-bundle",
          "symfony/notifier",
          "symfony/phpunit-bridge",
          "symfony/process",
          "symfony/property-access",
          "symfony/property-info",
          "symfony/runtime",
          "symfony/scheduler",
          "symfony/security-bundle",
          "symfony/serializer",
          "symfony/stimulus-bundle",
          "symfony/stopwatch",
          "symfony/string",
          "symfony/translation",
          "symfony/twig-bundle",
          "symfony/uid",
          "symfony/ux-live-component",
          "symfony/ux-turbo",
          "symfony/validator",
          "symfony/web-link",
          "symfony/web-profiler-bundle",
          "symfony/workflow",
          "symfony/yaml"
        ],
        "twig/twig": [
          "twig/intl-extra",
          "twig/inky-extra",
          "twig/extra-bundle",
          "twig/cssinliner-extra"
        ]
      },
      "blocklist": [
        "symfony/asset",
        "symfony/asset-mapper",
        "symfony/brevo-mailer",
        "symfony/browser-kit",
        "symfony/console",
        "symfony/css-selector",
        "symfony/debug-bundle",
        "symfony/doctrine-messenger",
        "symfony/dotenv",
        "symfony/event-dispatcher",
        "symfony/expression-language",
        "symfony/form",
        "symfony/http-client",
        "symfony/intl",
        "symfony/lock",
        "symfony/mailer",
        "symfony/maker-bundle",
        "symfony/mime",
        "symfony/monolog-bundle",
        "symfony/notifier",
        "symfony/phpunit-bridge",
        "symfony/process",
        "symfony/property-access",
        "symfony/property-info",
        "symfony/runtime",
        "symfony/scheduler",
        "symfony/security-bundle",
        "symfony/serializer",
        "symfony/stimulus-bundle",
        "symfony/stopwatch",
        "symfony/string",
        "symfony/translation",
        "symfony/twig-bundle",
        "symfony/uid",
        "symfony/ux-live-component",
        "symfony/ux-turbo",
        "symfony/validator",
        "symfony/web-link",
        "symfony/web-profiler-bundle",
        "symfony/workflow",
        "symfony/yaml",
        "twig/intl-extra",
        "twig/inky-extra",
        "twig/extra-bundle",
        "twig/cssinliner-extra"
      ]
    }
  },
  "require-dev": {
    "carthage-software/mago": "^1.47.1",
    "dama/doctrine-test-bundle": "^8.6.0",
    "kodus/mock-cache": "^2.1",
    "phpunit/phpunit": "^11.5.56",
    "roave/security-advisories": "dev-latest",
    "rregeer/phpunit-coverage-check": "^0.3.1",
    "symfony/browser-kit": "8.0.*",
    "symfony/contracts": "^3.7.2",
    "symfony/css-selector": "8.0.*",
    "symfony/debug-bundle": "8.0.*",
    "symfony/maker-bundle": "^1.67",
    "symfony/phpunit-bridge": "^8.0",
    "symfony/stopwatch": "8.0.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "zenstruck/foundry": "^2.12.0",
    "zenstruck/mailer-test": "^1.5.0",
    "zenstruck/messenger-test": "^1.15"
  }
}
