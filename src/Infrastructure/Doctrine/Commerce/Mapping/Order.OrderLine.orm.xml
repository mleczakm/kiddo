<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Commerce\Order\OrderLine" table="order_line">
        <id name="id" type="ulid" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="orderId" type="ulid" column="order_id" />
        <field name="lessonId" type="ulid" column="lesson_id" nullable="true" />
        <field name="seriesId" type="ulid" column="series_id" nullable="true" />
        <field name="ticketType" type="string" column="ticket_type" length="30" />
        <field name="title" type="string" column="title" length="255" />
        <field name="scheduleDescription" type="string" column="schedule_description" length="255" nullable="true" />
        <field name="participantId" type="ulid" column="participant_id" nullable="true" />
        <field name="basePriceMinor" type="integer" column="base_price_minor" />
        <field name="finalPriceMinor" type="integer" column="final_price_minor" />
        <field name="currency" type="string" column="currency" length="3" />
        <field name="pricingQuoteHash" type="string" column="pricing_quote_hash" length="64" nullable="true" />
        <field name="bookingId" type="ulid" column="booking_id" nullable="true" unique="true" />

        <indexes>
            <index name="idx_order_line_order_id" columns="order_id" />
        </indexes>
    </entity>
</doctrine-mapping>
