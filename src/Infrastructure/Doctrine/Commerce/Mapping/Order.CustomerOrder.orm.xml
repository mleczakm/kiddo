<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Commerce\Order\CustomerOrder" table="customer_order">
        <id name="id" type="ulid" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="orderNumber" type="string" column="order_number" length="32" unique="true" />
        <field name="customerId" type="integer" column="customer_id" />
        <field name="status" type="string" column="status" length="20" />
        <field name="currency" type="string" column="currency" length="3" />
        <field name="subtotalMinor" type="integer" column="subtotal_minor" />
        <field name="discountTotalMinor" type="integer" column="discount_total_minor" />
        <field name="totalMinor" type="integer" column="total_minor" />
        <field name="placedAt" type="datetime_immutable" column="placed_at" />
        <field name="expiresAt" type="datetime_immutable" column="expires_at" nullable="true" />
        <field name="checkoutKey" type="string" column="checkout_key" length="64" unique="true" />
        <field name="source" type="string" column="source" length="20" />
        <field name="version" type="integer" column="version" version="true" />

        <indexes>
            <index name="idx_customer_order_customer_id" columns="customer_id" />
            <index name="idx_customer_order_status" columns="status" />
            <index name="idx_customer_order_placed_at" columns="placed_at" />
        </indexes>
    </entity>
</doctrine-mapping>
