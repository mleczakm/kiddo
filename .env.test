# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
APP_ENV=test

###> kiddo/brevo-newsletter ###
# Empty API key ensures BrevoNewsletterService::isConfigured() is false in tests,
# so real HTTP calls never fire. Tests that need to observe Brevo interactions
# replace the service instance via self::getContainer()->set(...).
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=0
BREVO_DOI_TEMPLATE_ID=0
BREVO_DOI_REDIRECTION_URL=http://localhost:8000/newsletter-potwierdzony
###< kiddo/brevo-newsletter ###
