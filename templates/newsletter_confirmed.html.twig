{% extends 'base.html.twig' %}

{% block title %}{{ 'newsletter.confirmed.title'|trans }}{% endblock %}

{% block body %}
    <main class="flex-grow">
        <section class="py-16">
            <div class="container mx-auto px-4 max-w-2xl">
                <div class="bg-white rounded-2xl p-8 md:p-12 shadow-lg text-center">
                    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <h1 class="text-3xl font-bold font-display text-workshop-brown mb-4">
                        {{ 'newsletter.confirmed.title'|trans }}
                    </h1>
                    <p class="text-lg text-muted-foreground mb-8">
                        {{ 'newsletter.confirmed.message'|trans }}
                    </p>
                    <a href="{{ path('homepage') }}" class="btn-primary inline-block">
                        {{ 'newsletter.confirmed.back_home'|trans }}
                    </a>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
