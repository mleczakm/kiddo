<div {{ attributes }}>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col">
        <div class="p-6 border-b border-slate-100 bg-slate-50 shrink-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <h3 class="flex items-center gap-3 text-lg font-black text-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-5 h-5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>{{ 'admin_users.title'|trans }}</span>
            </h3>
            <div class="flex items-center gap-3">
                <div class="relative flex-1 sm:w-64">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    <input type="search" placeholder="{{ 'admin_users.search.placeholder'|trans }}" class="w-full pl-9 pr-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" data-model="query"/>
                </div>
                <button disabled class="inline-flex items-center justify-center whitespace-nowrap text-sm font-bold transition disabled:pointer-events-none disabled:opacity-50 bg-indigo-600 text-white hover:bg-indigo-700 h-10 px-4 rounded-lg shadow-sm shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    {{ 'admin_users.add_user'|trans }}
                </button>
            </div>
        </div>

        {# Clients — desktop table (md and up) #}
        <div class="hidden md:block">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4 font-semibold">{{ 'admin_users.table.name'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin_users.table.email'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin_users.table.children'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin_users.table.role'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin_users.table.status'|trans }}</th>
                            <th class="px-6 py-4 font-semibold text-right">{{ 'admin_users.table.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for user in this.getUsers() %}
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-9 w-9 rounded-full shrink-0 bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm">{{ user.email|slice(0, 1)|upper }}</div>
                                        <a href="{{ path('app_admin_user_view', { id: user.id }) }}" class="font-bold text-slate-800 hover:text-indigo-600 transition">{{ user.name }}</a>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-600">{{ user.email }}</td>
                                <td class="px-6 py-4 text-slate-600">
                                    {% if user.children|length > 0 %}
                                        {{ user.children|map(c => c.name)|join(', ') }}
                                    {% else %}
                                        <span class="text-slate-400">—</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold bg-slate-100 text-slate-600">{{ user.roles|join(', ') }}</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold bg-green-100 text-green-700">{{ 'admin_users.status.active'|trans }}</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <button
                                            data-action="live#action"
                                            data-live-action-param="startCompose"
                                            data-live-user-id-param="{{ user.id }}"
                                            class="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition"
                                            title="{{ 'admin_users.actions.notify'|trans }}"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                                        </button>
                                        <a href="{{ path('app_admin_user_view', { id: user.id }) }}" class="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="{{ 'admin_users.actions.edit'|trans }}">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="p-8 text-center text-slate-400 font-medium">{{ 'admin_users.search.no_results'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Clients — mobile cards (below md) #}
        <div class="md:hidden divide-y divide-slate-100">
            {% for user in this.getUsers() %}
                <div class="p-4 flex items-start gap-3">
                    <div class="h-10 w-10 rounded-full shrink-0 bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm">{{ user.email|slice(0, 1)|upper }}</div>
                    <div class="min-w-0 flex-1">
                        <a href="{{ path('app_admin_user_view', { id: user.id }) }}" class="font-bold text-slate-800 hover:text-indigo-600 transition">{{ user.name }}</a>
                        <p class="text-xs text-slate-500 truncate">{{ user.email }}</p>
                        <p class="text-xs text-slate-500 mt-1">
                            {% if user.children|length > 0 %}
                                {{ user.children|map(c => c.name)|join(', ') }}
                            {% else %}
                                <span class="text-slate-400">{{ 'admin_users.table.children'|trans }}: —</span>
                            {% endif %}
                        </p>
                        <div class="flex flex-wrap gap-1.5 mt-2">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-bold bg-slate-100 text-slate-600">{{ user.roles|join(', ') }}</span>
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-bold bg-green-100 text-green-700">{{ 'admin_users.status.active'|trans }}</span>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1 shrink-0">
                        <button
                            data-action="live#action"
                            data-live-action-param="startCompose"
                            data-live-user-id-param="{{ user.id }}"
                            class="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition"
                            title="{{ 'admin_users.actions.notify'|trans }}"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                        </button>
                        <button disabled class="p-1.5 text-slate-300 cursor-not-allowed rounded-lg" title="{{ 'admin_users.actions.edit'|trans }}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                        </button>
                    </div>
                </div>
            {% else %}
                <p class="p-8 text-center text-slate-400 font-medium">{{ 'admin_users.search.no_results'|trans }}</p>
            {% endfor %}
        </div>
    </div>

    {% if this.composingForUser %}
        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-4">
            <div class="bg-white w-full sm:max-w-md rounded-2xl shadow-2xl flex flex-col animate-in fade-in zoom-in-95 duration-200">
                <div class="flex justify-between items-center p-6 border-b border-slate-100">
                    <div>
                        <h2 class="text-lg font-black text-slate-800">{{ 'admin_users.notify.title'|trans }}</h2>
                        <p class="text-sm text-slate-500">{{ this.composingForUser.name }} ({{ this.composingForUser.email }})</p>
                    </div>
                    <button data-action="live#action" data-live-action-param="cancelCompose" class="p-2 text-slate-400 hover:bg-slate-100 rounded-full transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="p-6 space-y-4">
                    <div class="space-y-1.5">
                        <label class="text-sm font-bold text-slate-700">{{ 'admin_users.notify.subject'|trans }} *</label>
                        <input type="text" data-model="notifyTitle" placeholder="{{ 'admin_users.notify.subject_placeholder'|trans }}" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-sm font-bold text-slate-700">{{ 'admin_users.notify.body'|trans }}</label>
                        <textarea data-model="notifyBody" rows="3" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none" placeholder="{{ 'admin_users.notify.body_placeholder'|trans }}"></textarea>
                    </div>
                </div>
                <div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl">
                    <button data-action="live#action" data-live-action-param="cancelCompose" class="px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition">
                        {{ 'admin_users.notify.cancel'|trans }}
                    </button>
                    <button data-action="live#action" data-live-action-param="sendNotification" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-sm transition">
                        {{ 'admin_users.notify.send'|trans }}
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
