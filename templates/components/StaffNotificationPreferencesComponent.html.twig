<div {{ attributes }}>
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="mb-2 flex items-center gap-3 text-base font-black text-slate-800">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>{{ 'notification_preferences.title'|trans({}, 'admin') }}</span>
        </h3>
        <p class="mb-4 text-sm text-slate-500">{{ 'notification_preferences.intro'|trans({}, 'admin') }}</p>
        <label class="inline-flex items-center gap-3 text-sm font-semibold text-slate-700">
            <input type="checkbox"
                   {{ this.operationalEmailsEnabled ? 'checked' : '' }}
                   data-action="change->live#action"
                   data-live-action-param="toggle"
                   data-loading="attr(disabled)"
                   class="h-4 w-4 rounded border-slate-300 text-indigo-600">
            <span>{{ 'notification_preferences.label'|trans({}, 'admin') }}</span>
        </label>
        <p class="mt-3 text-xs text-slate-400">{{ 'notification_preferences.note'|trans({}, 'admin') }}</p>
    </div>
</div>
