<div {{ attributes }} class="rounded-3xl bg-gradient-to-br from-slate-800 to-slate-900 p-6 shadow-sm text-white flex flex-col justify-between min-h-40 md:col-span-2 relative overflow-hidden">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute right-[-20px] bottom-[-20px] w-32 h-32 opacity-10 text-white" aria-hidden="true">
        <rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect>
        <path d="M9 22v-4h6v4"></path>
        <path d="M8 6h.01"></path>
        <path d="M16 6h.01"></path>
        <path d="M12 6h.01"></path>
        <path d="M12 10h.01"></path>
        <path d="M12 14h.01"></path>
        <path d="M16 10h.01"></path>
        <path d="M16 14h.01"></path>
        <path d="M8 10h.01"></path>
        <path d="M8 14h.01"></path>
    </svg>

    <div class="flex items-center justify-between gap-2 flex-wrap">
        <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <span>Opłata systemowa (2% prowizji)</span>
            {{ include('admin/help/_context_button.html.twig', {slug: 'rozliczenie-platformy', label: 'Opłata systemowa i rozliczenie platformy'}) }}
        </div>
        {% if this.hasPastDue() %}
            <div class="flex items-center gap-1 text-xs font-bold text-red-400 shrink-0 ml-auto">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
                <span>Zaległość {{ this.getPastDue()|number_format(2) }} zł</span>
            </div>
        {% endif %}
    </div>

    <div class="text-4xl font-black text-white tracking-tight mb-2">{{ this.getCurrentDue()|number_format(2) }} zł</div>
    <div class="text-xs text-slate-400 font-medium">Prognoza za bieżący miesiąc</div>

    {% if this.hasPastDue() and is_granted('ROLE_SUPER_ADMIN') %}
        <div class="mt-4 flex flex-wrap gap-2">
            <button
                data-action="live#action"
                data-live-action-param="setPastDueAsPaid"
                class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition shadow-sm"
            >
                Oznacz zaległość jako opłaconą
            </button>
            <button
                data-action="live#action"
                data-live-action-param="openModal"
                class="bg-slate-700 hover:bg-slate-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition shadow-sm"
            >
                Wpłać inną kwotę
            </button>
        </div>
    {% endif %}

    <p class="text-[10px] text-slate-400 mt-4 leading-tight max-w-[80%]">Naliczane od przelewów dopasowanych automatycznie i ręcznie w panelu Przelewów. Wpłaty przyjęte na miejscu bez oczekującej płatności = 0% prowizji.</p>

    {% if successMessage %}
        <div class="mt-4 bg-green-50 border border-green-200 rounded-xl p-4 text-green-800 text-sm font-medium">
            {{ successMessage }}
        </div>
    {% endif %}

    {% if errorMessage %}
        <div class="mt-4 bg-red-50 border border-red-200 rounded-xl p-4 text-red-800 text-sm font-medium">
            {{ errorMessage }}
        </div>
    {% endif %}

    {% if showModal %}
        <div data-controller="modal-transition"
             data-modal-transition-target="overlay"
             data-state="open"
             class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0">
            <div data-modal-transition-target="panel"
                 data-state="open"
                 class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95">
                <h3 class="text-lg font-bold text-slate-800 mb-4">Wpłata na zaległość</h3>

                {{ form_start(form) }}
                    <div class="space-y-4">
                        <div>
                            {{ form_label(form.amount, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                            <div class="relative">
                                {{ form_widget(form.amount) }}
                                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-400">zł</span>
                            </div>
                            {% if form.amount.vars.errors|length > 0 %}
                                <div class="text-red-500 text-xs mt-1">
                                    {{ form_errors(form.amount) }}
                                </div>
                            {% endif %}
                            <p class="text-xs text-slate-500 mt-1">Aktualna zaległość: {{ this.getPastDue()|number_format(2) }} zł</p>
                        </div>

                        <div class="flex gap-2">
                            {{ form_widget(form.submit, {'attr': {'class': 'flex-1 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-bold transition shadow-sm'}}) }}
                            <button
                                type="button"
                                data-action="click->modal-transition#close click->live#action"
                                data-live-action-param="closeModal"
                                class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm font-bold transition"
                            >
                                Anuluj
                            </button>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    {% endif %}
</div>
