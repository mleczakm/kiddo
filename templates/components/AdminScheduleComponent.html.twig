<div {{ attributes }} class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
  <div class="p-6 border-b border-slate-100 bg-slate-50 shrink-0 flex flex-col space-y-1.5">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-4">
      <h3 class="flex items-center gap-3 text-lg font-black text-slate-800">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-range w-5 h-5"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
        <span>{{ 'admin.schedule.title'|trans }}</span>
      </h3>
      <div class="flex flex-wrap items-center gap-2">
        {% if is_granted('ROLE_MANAGE_SCHEDULE') %}
          <button type="button"
                  data-action="live#action"
                  data-live-action-param="openAddModal"
                  data-tour-target="add-workshop"
                  class="bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 h-9 rounded-xl text-sm font-bold flex items-center gap-2 transition shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            {{ 'admin.schedule.add_workshop'|trans }}
          </button>
        {% endif %}
        <button type="button"
                data-action="live#action"
                data-live-action-param="toggleCancelled"
                class="px-3 py-1.5 border rounded-md hover:bg-gray-50 flex items-center text-sm {{ this.showCancelled ? 'bg-gray-100 border-gray-400' : 'bg-white' }}"
                title="{{ this.showCancelled ? 'admin.lessons.hide_cancelled'|trans : 'admin.lessons.show_cancelled'|trans }}">
          <span class="sr-only">{{ this.showCancelled ? ('admin.lessons.hide_cancelled'|trans) : ('admin.lessons.show_cancelled'|trans) }}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            {% if this.showCancelled %}
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
            {% else %}
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            {% endif %}
          </svg>
        </button>
        <button type="button"
                data-model="week"
                data-value="{{ this.week|date_modify('-7 days')|date('Y-m-d') }}"
                data-action="live#update"
                class="h-9 w-9 border border-slate-200 bg-white rounded-xl hover:bg-slate-50 flex items-center justify-center text-slate-700 transition"
                title="{{ 'lesson.previous_week'|trans }}">
          <span class="sr-only">{{ 'lesson.previous_week'|trans }}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <span class="h-9 px-3.5 flex items-center text-xs bg-slate-100 text-slate-700 font-bold rounded-xl whitespace-nowrap">
          {{ this.weekStart|date('d.m') }} - {{ this.weekEnd|date('d.m') }}
        </span>
        <button type="button"
                data-model="week"
                data-value="{{ this.week|date_modify('+7 days')|date('Y-m-d') }}"
                data-action="live#update"
                class="h-9 w-9 border border-slate-200 bg-white rounded-xl hover:bg-slate-50 flex items-center justify-center text-slate-700 transition"
                title="{{ 'lesson.next_week'|trans }}">
          <span class="sr-only">{{ 'lesson.next_week'|trans }}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="p-6 pt-0 space-y-3">
    {% for group in this.groups %}
      {% set series = group.series %}
      <div class="border border-slate-200 rounded-xl overflow-hidden {{ series and series.status == 'cancelled' ? 'opacity-60' : '' }}">
        <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white {{ series ? 'cursor-pointer hover:bg-slate-50 transition' : '' }}"
             {% if series %}
               role="button" tabindex="0"
               data-action="click->live#action"
               data-live-action-param="openPreview"
               data-live-series-id-param="{{ series.id }}"
             {% endif %}>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-slate-800">{{ series ? series.firstLesson.metadata.title : group.lessons[0].metadata.title }}</span>
              <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-slate-500">
                {{ series ? (series.type.value == 'weekly' ? 'admin.schedule.type.weekly'|trans : 'admin.schedule.type.one_time'|trans) : 'admin.schedule.type.one_time'|trans }}
              </span>
              {% set status = series ? series.status : group.lessons[0].status %}
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold {{ status == 'active' ? 'border-transparent bg-green-500 text-white' : 'border-transparent bg-red-500 text-white' }}">
                {{ status == 'active' ? 'admin.lessons.status.active'|trans : 'admin.lessons.status.cancelled'|trans }}
              </span>
            </div>
            <div class="text-xs text-muted-foreground mt-1">
              {% if series %}
                {{ series.firstLesson.schedule|date('Y-m-d') }} — {{ series.lastLesson.schedule|date('Y-m-d') }}
              {% else %}
                {{ group.lessons[0].schedule|date('Y-m-d H:i') }}
              {% endif %}
            </div>
            {% if series and series.ticketOptions %}
              <div class="flex flex-wrap gap-1 mt-2">
                {% for t in this.getTicketTypes(series) %}
                  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-gray-100">{{ ('lesson.' ~ t)|trans }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
          {% if series and is_granted('ROLE_MANAGE_SCHEDULE') %}
            <div class="flex gap-2 shrink-0">
              <button data-action="click->live#action:stop"
                      data-live-action-param="startEdit"
                      data-live-series-id-param="{{ series.id }}"
                      class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium border bg-background hover:text-accent-foreground h-9 rounded-md px-3 border-blue-600 text-blue-600 hover:bg-blue-600/10">
                {{ 'admin.schedule.actions.edit'|trans }}
              </button>
            </div>
          {% endif %}
        </div>

        {% if series %}
          {# This week's occurrences for this series #}
          <div class="border-t border-slate-100 bg-slate-50 divide-y divide-slate-100">
            {% for lesson in group.lessons %}
              <div class="px-4 py-2.5 flex items-center justify-between gap-3 {{ lesson.status == 'cancelled' ? 'opacity-60' : '' }}">
                <a class="text-sm hover:underline {{ lesson.status == 'cancelled' ? 'line-through text-red-600' : 'text-slate-700' }}" href="{{ path('app_admin_lesson_view', { id: lesson.id }) }}">
                  {{ lesson.schedule|date('d.m.Y H:i') }}
                </a>
                <div class="flex items-center gap-3">
                  <span class="text-xs font-medium text-slate-500">{{ lesson.bookings|length }}/{{ lesson.metadata.capacity }}</span>
                  <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold {{ lesson.status == 'active' ? 'border-transparent bg-green-500 text-white' : 'border-transparent bg-red-500 text-white' }}">
                    {{ lesson.status == 'active' ? 'admin.lessons.status.active'|trans : 'admin.lessons.status.cancelled'|trans }}
                  </span>
                  {% if is_granted('LESSON_MANAGE', lesson) %}
                    <button type="button"
                            data-action="click->live#action"
                            data-live-action-param="toggleLessonStatus"
                            data-live-lesson-id-param="{{ lesson.id }}"
                            class="inline-flex items-center justify-center whitespace-nowrap text-xs font-bold border h-7 rounded-md px-2.5 {{ lesson.status == 'active' ? 'border-red-600 text-red-600 hover:bg-red-600/10' : 'border-green-600 text-green-600 hover:bg-green-600/10' }}">
                      {{ lesson.status == 'active' ? ('admin.lessons.actions.deactivate'|trans) : ('admin.lessons.actions.activate'|trans) }}
                    </button>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          {% set lesson = group.lessons[0] %}
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-2.5 flex items-center justify-end gap-3">
            <a class="text-sm text-slate-500 hover:underline mr-auto" href="{{ path('app_admin_lesson_view', { id: lesson.id }) }}">{{ 'admin.lessons.open'|trans }}</a>
            <span class="text-xs font-medium text-slate-500">{{ lesson.bookings|length }}/{{ lesson.metadata.capacity }}</span>
            {% if is_granted('LESSON_MANAGE', lesson) %}
              <button type="button"
                      data-action="click->live#action"
                      data-live-action-param="toggleLessonStatus"
                      data-live-lesson-id-param="{{ lesson.id }}"
                      class="inline-flex items-center justify-center whitespace-nowrap text-xs font-bold border h-7 rounded-md px-2.5 {{ lesson.status == 'active' ? 'border-red-600 text-red-600 hover:bg-red-600/10' : 'border-green-600 text-green-600 hover:bg-green-600/10' }}">
                {{ lesson.status == 'active' ? ('admin.lessons.actions.deactivate'|trans) : ('admin.lessons.actions.activate'|trans) }}
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <p class="p-4 text-center text-muted-foreground">{{ 'admin.schedule.empty'|trans }}</p>
    {% endfor %}
  </div>

  {% if this.showAddModal %}
    {{ component('WorkshopEditor') }}
  {% elseif this.editSeriesId %}
    {{ component('WorkshopEditor', { seriesId: this.editSeriesId, endToday: this.endingSeries }) }}
  {% elseif this.previewSeriesId %}
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/50">
      <div class="bg-slate-50 rounded-3xl shadow-2xl w-full max-w-5xl max-h-[92vh] overflow-y-auto">
        <div class="sticky top-0 z-10 flex items-center justify-between gap-3 p-4 border-b border-slate-200 bg-white rounded-t-3xl">
          <h2 class="font-black text-slate-800">Podgląd warsztatu</h2>
          <div class="flex items-center gap-2">
            {% if is_granted('ROLE_MANAGE_SCHEDULE') %}
              <button type="button" data-action="click->live#action" data-live-action-param="endSeries" data-live-series-id-param="{{ this.previewSeriesId }}" class="h-9 px-3 rounded-xl border border-red-200 text-red-700 text-sm font-bold hover:bg-red-50">Zakończ cykl</button>
              <button type="button" data-action="click->live#action" data-live-action-param="startEdit" data-live-series-id-param="{{ this.previewSeriesId }}" class="h-9 px-3 rounded-xl bg-indigo-600 text-white text-sm font-bold hover:bg-indigo-700">Edytuj</button>
            {% endif %}
            <button type="button" data-action="click->live#action" data-live-action-param="closePreview" class="h-9 w-9 rounded-xl border border-slate-200 text-slate-600" aria-label="Zamknij">×</button>
          </div>
        </div>
        <div class="p-4">
          {{ component('SeriesDetails', { seriesId: this.previewSeriesId }) }}
        </div>
      </div>
    </div>
  {% endif %}
</div>
