{% set current_route = app.request.attributes.get('_route') %}

{# Backdrop shown behind the drawer on mobile #}
<div class="hidden fixed inset-0 bg-slate-900/50 z-30 md:hidden"
     data-admin-sidebar-target="backdrop"
     data-action="click->admin-sidebar#close"
     aria-hidden="true"></div>

<aside class="fixed inset-y-0 left-0 -translate-x-full md:static md:translate-x-0 transition-transform duration-200 ease-out flex w-64 shrink-0 flex-col bg-slate-900 text-slate-300 min-h-screen z-40 shadow-xl border-r border-slate-800"
       data-admin-sidebar-target="panel">
    <div class="p-6 flex items-start justify-between">
        <div>
            <div class="text-2xl font-black text-white tracking-tight">Kiddo<span class="text-indigo-500">.</span></div>
            <p class="text-[10px] text-slate-500 uppercase tracking-wider font-bold mt-1">System Zarządzania</p>
        </div>
        <button type="button"
                class="md:hidden p-1.5 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition"
                data-action="admin-sidebar#close"
                aria-label="{{ 'admin.menu.toggle'|trans }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
    </div>

    <nav aria-label="Admin navigation" class="flex-1 px-4 py-2 space-y-1 overflow-y-auto">
        <ul class="space-y-1" data-testid="admin-menu">
            {% if is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_admin_dashboard') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route == 'app_admin_dashboard' ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route == 'app_admin_dashboard' ? 'page' : 'false' }}"
                   data-tour-target="nav-dashboard">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard shrink-0"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="10" rx="1"/><rect width="7" height="5" x="3" y="14" rx="1"/></svg>
                        <span>{{ 'admin.tabs.dashboard'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGE_SCHEDULE') %}
            <li>
                <a href="{{ path('app_admin_schedule') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route == 'app_admin_schedule' ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route == 'app_admin_schedule' ? 'page' : 'false' }}"
                   data-tour-target="nav-workshops">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-range shrink-0"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                        <span>{{ 'admin.tabs.workshops'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGE_LESSONS') %}
            <li>
                <a href="{{ path('app_admin_lessons') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route in ['app_admin_lessons', 'app_admin_lesson_view', 'app_admin_lesson_toggle'] ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route in ['app_admin_lessons', 'app_admin_lesson_view', 'app_admin_lesson_toggle'] ? 'page' : 'false' }}"
                   data-tour-target="nav-lessons">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open shrink-0"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        <span>{{ 'admin.tabs.lessons'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGE_BOOKINGS') %}
            <li>
                <a href="{{ path('app_admin_bookings') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route == 'app_admin_bookings' ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route == 'app_admin_bookings' ? 'page' : 'false' }}"
                   data-tour-target="nav-bookings">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ticket shrink-0"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
                        <span>{{ 'admin.tabs.bookings'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGE_USERS') %}
            <li>
                <a href="{{ path('app_admin_users') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route in ['app_admin_users', 'app_admin_user_view'] ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route in ['app_admin_users', 'app_admin_user_view'] ? 'page' : 'false' }}" data-testid="admin-menu-users-link"
                   data-tour-target="nav-users">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users shrink-0"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>{{ 'admin.tabs.users'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGE_PAYMENTS') %}
            <li>
                <a href="{{ path('app_admin_transfers') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route == 'app_admin_transfers' ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route == 'app_admin_transfers' ? 'page' : 'false' }}"
                   data-tour-target="nav-transfers">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet shrink-0"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
                        <span>{{ 'admin.tabs.transfers'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
            {% if is_granted('ROLE_MANAGE_MESSAGES') %}
            <li>
                <a href="{{ path('app_admin_messages') }}"
                   class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route == 'app_admin_messages' ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
                   aria-current="{{ current_route == 'app_admin_messages' ? 'page' : 'false' }}"
                   data-tour-target="nav-messages">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle shrink-0"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                        <span>{{ 'admin.tabs.messages'|trans }}</span>
                    </div>
                </a>
            </li>
            {% endif %}
        </ul>
    </nav>

    <div class="p-4 border-t border-slate-800 space-y-1">
        {% if is_granted('ROLE_SETTINGS') %}
        <a href="{{ path('app_admin_settings') }}"
           class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors text-sm font-medium {{ current_route == 'app_admin_settings' ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 hover:text-white' }}"
           aria-current="{{ current_route == 'app_admin_settings' ? 'page' : 'false' }}"
           data-tour-target="settings-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings shrink-0"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>{{ 'admin.tabs.settings'|trans }}</span>
        </a>
        {% endif %}
        <a href="{{ path('homepage') }}" target="_blank" rel="noopener"
           class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors text-sm font-medium hover:bg-slate-800 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link shrink-0"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            <span>{{ 'admin.menu.view_site'|trans }}</span>
        </a>
    </div>
</aside>
