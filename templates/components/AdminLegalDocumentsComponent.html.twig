<div {{ attributes }} class="space-y-8">
    <div>
        <h2 class="text-xl font-black text-slate-800">Dokumenty prawne</h2>
        <p class="mt-1 text-sm text-slate-500">Każda publikacja tworzy nową, niemodyfikowalną wersję. Dokument zaczyna obowiązywać we wskazanym dniu.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
        {% for card in this.documentCards %}
            <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h3 class="font-black text-slate-800">{{ card.type.label }}</h3>
                        <a href="{{ path(card.type.routeName) }}" target="_blank" rel="noopener"
                           class="mt-1 inline-block text-xs font-bold text-indigo-600 hover:underline">Otwórz stronę publiczną</a>
                    </div>
                    {% if card.current %}
                        <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-700">wersja {{ card.current.version }}</span>
                    {% else %}
                        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-700">statyczny fallback</span>
                    {% endif %}
                </div>

                {% if card.current %}
                    <p class="mt-3 text-xs text-slate-500">Obowiązuje od {{ card.current.effectiveFrom|format_datetime('long', 'none', locale: 'pl') }}</p>
                {% endif %}

                <div class="mt-4 space-y-2">
                    {% for version in card.versions %}
                        {% set fileUrl = path('stored_file', {id: version.file.id, safeName: version.file.originalName}) %}
                        <div class="rounded-xl border border-slate-200 bg-white p-3 text-xs">
                            <div class="flex items-center justify-between gap-3">
                                <a href="{{ fileUrl }}" target="_blank" class="min-w-0 truncate font-bold text-indigo-600 hover:underline">
                                    Wersja {{ version.version }} · {{ version.file.originalName }}
                                </a>
                                <span class="shrink-0 text-slate-400">{{ version.effectiveFrom|date('d.m.Y') }}</span>
                            </div>
                            {% if version.changeSummary %}<p class="mt-1 text-slate-500">{{ version.changeSummary }}</p>{% endif %}
                            <p class="mt-1 truncate font-mono text-[10px] text-slate-400" title="{{ version.checksum }}">SHA-256: {{ version.checksum }}</p>
                        </div>
                    {% else %}
                        <p class="text-xs text-slate-500">Nie wgrano jeszcze żadnej wersji. Strona publiczna korzysta z treści statycznej.</p>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>

    <section class="max-w-2xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="font-black text-slate-800">Wgraj nową wersję</h3>
        <div class="mt-5 space-y-4">
            <div class="space-y-1.5">
                <label class="text-sm font-bold text-slate-700">Dokument</label>
                <select data-model="documentType" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm">
                    {% for type in this.documentTypes %}
                        <option value="{{ type.value }}" {{ documentType == type.value ? 'selected' : '' }}>{{ type.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-sm font-bold text-slate-700">Data wejścia w życie</label>
                <input type="date" data-model="effectiveFrom" value="{{ effectiveFrom }}"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm">
            </div>

            <div class="space-y-1.5">
                <label class="text-sm font-bold text-slate-700">Opis zmian</label>
                <textarea data-model="changeSummary" maxlength="1000" rows="3"
                          placeholder="Krótka informacja widoczna przy wersji dokumentu"
                          class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm">{{ changeSummary }}</textarea>
            </div>

            <div class="space-y-1.5">
                <label class="text-sm font-bold text-slate-700">Plik PDF lub DOCX</label>
                <div class="dropzone-container" data-controller="symfony--ux-dropzone--dropzone">
                    <input type="file" name="legalDocumentFile" accept="application/pdf,.docx"
                           data-symfony--ux-dropzone--dropzone-target="input" class="dropzone-input">
                    <div class="dropzone-placeholder" data-symfony--ux-dropzone--dropzone-target="placeholder">
                        Przeciągnij plik tutaj albo kliknij, aby go wybrać
                    </div>
                    <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview" style="display: none">
                        <button class="dropzone-preview-button" type="button" data-symfony--ux-dropzone--dropzone-target="previewClearButton"></button>
                        <div class="dropzone-preview-image" style="display: none" data-symfony--ux-dropzone--dropzone-target="previewImage"></div>
                        <div class="dropzone-preview-filename" data-symfony--ux-dropzone--dropzone-target="previewFilename"></div>
                    </div>
                </div>
                <p class="text-xs text-slate-500">Maksymalny rozmiar pliku: 20 MB.</p>
            </div>

            <button type="button" data-action="live#action" data-live-action-param="publish"
                    class="rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white transition hover:bg-indigo-700">
                Opublikuj nową wersję
            </button>
        </div>
    </section>
</div>
