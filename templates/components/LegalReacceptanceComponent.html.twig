<div {{ attributes }}>
    {% set stale = this.getPendingDocuments() %}
    {% if stale is not empty %}
        <div class="mb-6 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
            <p class="font-bold">{{ 'legal.reaccept.title'|trans }}</p>
            <p class="mt-1">{{ 'legal.reaccept.lead'|trans }}</p>
            <ul class="mt-2 list-disc space-y-0.5 pl-5">
                {% for doc in stale %}
                    <li><a href="{{ doc.url }}" target="_blank" rel="noopener" class="font-semibold underline">{{ doc.label }}</a></li>
                {% endfor %}
            </ul>
            <button type="button" data-action="live#action" data-live-action-param="reaccept"
                    class="mt-3 inline-flex items-center rounded-lg bg-amber-600 px-4 py-1.5 text-xs font-bold text-white transition hover:bg-amber-700">
                {{ 'legal.reaccept.accept'|trans }}
            </button>
        </div>
    {% endif %}
</div>
