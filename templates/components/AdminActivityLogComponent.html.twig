<div {{ attributes.defaults({'data-poll': 'delay(15000)|refresh'}) }}>
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-50">
            <h3 class="flex items-center gap-3 text-base font-black text-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M16 3h5v5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 21H3v-5"/></svg>
                <span>{{ 'admin_dashboard.activity_log.title'|trans }}</span>
            </h3>
            <button type="button" data-action="live#action" data-live-action-param="refresh" class="text-slate-400 hover:text-slate-600 transition" title="{{ 'admin_dashboard.activity_log.refresh'|trans }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
            </button>
        </div>

        {# Activity feed rows #}
        {% set logs = this.getActivityLog() %}
        {% if logs is empty %}
            <p class="text-sm text-slate-400 text-center py-8">{{ 'admin_dashboard.activity_log.empty'|trans }}</p>
        {% else %}
            <div class="space-y-3">
                {% for log in logs %}
                    {% set colors = {
                        indigo: 'bg-indigo-50 text-indigo-700 border-indigo-100',
                        emerald: 'bg-emerald-50 text-emerald-700 border-emerald-100',
                        amber: 'bg-amber-50 text-amber-700 border-amber-100',
                        blue: 'bg-blue-50 text-blue-700 border-blue-100',
                        red: 'bg-red-50 text-red-700 border-red-100',
                        slate: 'bg-slate-50 text-slate-700 border-slate-100',
                    } %}
                    {% set colorClasses = colors[log.color] ?? colors.slate %}
                    <a href="{{ log.url ?? '#' }}"
                       class="flex items-start gap-3 p-3 border border-slate-100 rounded-2xl bg-white hover:bg-slate-50 transition {{ log.url is null ? 'pointer-events-none' : '' }}">
                        <span class="shrink-0 mt-0.5 inline-flex items-center justify-center w-8 h-8 rounded-full border {{ colorClasses }}">
                            {% if log.icon == 'user-plus' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                            {% elseif log.icon == 'calendar-plus' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
                            {% elseif log.icon == 'calendar-x' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="10" y1="14" x2="14" y2="18"/><line x1="14" y1="14" x2="10" y2="18"/></svg>
                            {% elseif log.icon == 'calendar-clock' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13.255A23.931 23.931 0 0 1 12 15c-3.183 0-6.22-.62-9-1.745"/><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><circle cx="16" cy="16" r="0.5" fill="currentColor"/></svg>
                            {% elseif log.icon == 'rotate-ccw' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                            {% elseif log.icon == 'banknote' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                            {% elseif log.icon == 'alert-triangle' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            {% elseif log.icon == 'mail' %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            {% else %}
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                            {% endif %}
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="flex items-center justify-between gap-2">
                                <span class="font-bold text-slate-800 text-sm truncate">{{ log.title }}</span>
                                <span class="shrink-0 text-[10px] text-slate-400 font-medium whitespace-nowrap">{{ log.createdAt|date('d.m H:i') }}</span>
                            </span>
                            {% if log.summary %}
                                <span class="block text-xs text-slate-500 mt-0.5 truncate">{{ log.summary }}</span>
                            {% endif %}
                        </span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
