<div {{ attributes }}>
  <div class="relative" data-controller="admin-search">
    <span class="absolute inset-y-0 left-3 flex items-center text-slate-400 pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
    </span>
    <input id="admin-global-search" type="search" placeholder="Szukaj klientów, rezerwacji lub zajęć... (Ctrl+K)"
           aria-label="Szukaj"
           value="{{ query }}" data-model="debounce(250)|query" data-admin-search-target="input"
           data-action="focus->admin-search#open keydown->admin-search#keydown"
           autocomplete="off"
           class="w-full pl-10 pr-12 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all focus:bg-white">
    <div class="absolute inset-y-0 right-3 flex items-center gap-1 text-slate-400 pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/></svg>K
    </div>

    {% if query|trim|length >= 2 %}
        <div data-admin-search-target="panel" class="absolute top-full mt-2 left-0 right-0 bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden z-50 max-h-[70vh] overflow-y-auto">
            {% for result in this.results %}
                <a href="{{ this.resultUrl(result.reference) }}" class="flex gap-3 px-4 py-3 border-b border-slate-100 last:border-0 hover:bg-indigo-50 transition-colors">
                    <span class="mt-0.5 shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center" title="{{ result.reference.type.value }}">
                        {% if result.reference.type.value in ['client', 'child'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                        {% elseif result.reference.type.value == 'lesson' %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        {% elseif result.reference.type.value == 'booking' %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2M13 17v2M13 11v2"/></svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
                        {% endif %}
                        <span class="sr-only">{{ result.reference.type.value }}</span>
                    </span>
                    <span class="min-w-0">
                        <span class="block font-semibold text-sm text-slate-800 truncate">{{ result.title|highlight_search(query) }}</span>
                        <span class="block text-xs text-slate-500 truncate mt-0.5">{{ result.subtitle|highlight_search(query) }}</span>
                    </span>
                </a>
            {% else %}
                <p class="px-4 py-6 text-center text-sm text-slate-500">Brak wyników dla „{{ query }}”.</p>
            {% endfor %}
        </div>
    {% endif %}
  </div>
</div>
