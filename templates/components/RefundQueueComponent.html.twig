<div {{ attributes }} class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
  <div class="p-6 border-b border-slate-100 bg-slate-50 shrink-0">
    <h3 class="flex items-center gap-3 text-lg font-black text-slate-800">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw w-5 h-5 text-amber-600"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
      <span>{{ 'admin.refund_queue.title'|trans }}</span>
      {% if this.pendingCount > 0 %}
        <span class="inline-flex items-center justify-center rounded-full bg-amber-500 px-2.5 py-0.5 text-xs font-bold text-white">{{ this.pendingCount }}</span>
      {% endif %}
    </h3>
  </div>
  <div class="p-6 pt-4">
    {# Desktop table (md and up) #}
    <div class="hidden md:block relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors hover:bg-slate-50">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">{{ 'admin.refund_queue.headers.requested_at'|trans }}</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">{{ 'admin.refund_queue.headers.customer'|trans }}</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">{{ 'admin.refund_queue.headers.workshop'|trans }}</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">{{ 'admin.refund_queue.headers.amount'|trans }}</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">{{ 'admin.refund_queue.headers.message'|trans }}</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          {% for request in this.pendingRequests %}
            <tr class="cursor-pointer border-b transition-colors hover:bg-amber-50/50" data-action="click->live#emit" data-live-event-param="openReservationDetails" data-live-booking-id-param="{{ request.booking.id }}" role="button" tabindex="0">
              <td class="p-4 align-middle whitespace-nowrap">{{ request.requestedAt|date('Y-m-d H:i') }}</td>
              <td class="p-4 align-middle">
                <div class="font-medium">{{ request.booking.user.name }}</div>
                <div class="text-xs text-muted-foreground">{{ request.booking.user.email }}</div>
              </td>
              <td class="p-4 align-middle">{{ request.lesson ? request.lesson.metadata.title : '-' }}</td>
              <td class="p-4 align-middle font-medium">{{ request.requestedAmount|money }}</td>
              <td class="p-4 align-middle max-w-xs truncate text-slate-600">{{ request.requestMessage ?: '-' }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="p-4 text-center text-muted-foreground">{{ 'admin.refund_queue.empty'|trans }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Mobile cards (below md) #}
    <div class="md:hidden space-y-3">
      {% for request in this.pendingRequests %}
        <div class="cursor-pointer border border-slate-200 rounded-xl p-4 transition hover:border-amber-300 hover:bg-amber-50/50" data-action="click->live#emit" data-live-event-param="openReservationDetails" data-live-booking-id-param="{{ request.booking.id }}" role="button" tabindex="0">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="font-medium text-slate-800 truncate">{{ request.booking.user.name }}</div>
              <div class="text-xs text-muted-foreground truncate">{{ request.booking.user.email }}</div>
            </div>
            <span class="shrink-0 font-medium text-slate-800">{{ request.requestedAmount|money }}</span>
          </div>
          <div class="mt-2 text-sm text-slate-600">{{ request.lesson ? request.lesson.metadata.title : '-' }}</div>
          {% if request.requestMessage %}<div class="mt-1 text-xs text-slate-500 truncate">{{ request.requestMessage }}</div>{% endif %}
          <div class="mt-2 text-xs text-slate-400">{{ request.requestedAt|date('Y-m-d H:i') }}</div>
        </div>
      {% else %}
        <p class="p-4 text-center text-muted-foreground">{{ 'admin.refund_queue.empty'|trans }}</p>
      {% endfor %}
    </div>
  </div>
</div>
