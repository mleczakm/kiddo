<div {{ attributes }}>
{% if not isModalOpen %}
    <button
        data-action="live#action" data-live-action-param="openModal"
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-bold border h-10 rounded-xl px-4 border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors"
    >
        {{ editingLessonId ? 'admin.lesson_show.modify'|trans : 'admin.workshop_editor.add_button'|trans }}
    </button>
{% else %}
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center sm:p-4">
        <div class="bg-white w-full sm:max-w-4xl rounded-t-2xl sm:rounded-2xl shadow-2xl flex flex-col h-[95vh] sm:h-auto sm:max-h-[90vh] animate-in fade-in zoom-in-95 duration-200">

            <!-- Header -->
            <div class="flex justify-between items-center p-4 sm:p-6 border-b border-slate-100 shrink-0">
                <div class="min-w-0">
                    <h2 class="text-lg sm:text-xl font-black text-slate-800">
                        {{ editingLessonId ? 'admin.workshop_editor.title_edit'|trans : 'admin.workshop_editor.title_create'|trans }}
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500">
                        {{ editingLessonId ? 'admin.workshop_editor.lead_edit'|trans : 'admin.workshop_editor.lead_create'|trans }}
                    </p>
                </div>
                <button
                    data-action="live#action" data-live-action-param="close"
                    class="p-2 text-slate-400 hover:bg-slate-100 rounded-full transition shrink-0"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <!-- Edit scope selector — only relevant when editing a lesson that belongs to a series -->
            {% if editingLessonId and this.getEditingSeries() %}
                <div class="px-4 sm:px-6 py-3 bg-amber-50 border-b border-amber-100 shrink-0">
                    <p class="text-xs font-bold text-amber-900 mb-2 uppercase tracking-wide">{{ 'admin.workshop_editor.scope.label'|trans }}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <label class="flex items-start gap-2 p-3 rounded-xl border-2 cursor-pointer transition {{ editScope == 'occurrence' ? 'border-indigo-600 bg-white' : 'border-transparent bg-white/60 hover:bg-white' }}">
                            <input type="radio" name="editScope" data-model="editScope" value="occurrence" class="mt-0.5 w-4 h-4 text-indigo-600" />
                            <span>
                                <span class="block text-sm font-bold text-slate-800">{{ 'admin.workshop_editor.scope.occurrence'|trans }}</span>
                                <span class="block text-xs text-slate-500">{{ 'admin.workshop_editor.scope.occurrence_hint'|trans({ date: occurrenceDate, time: occurrenceTime }) }}</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-2 p-3 rounded-xl border-2 cursor-pointer transition {{ editScope == 'series' ? 'border-indigo-600 bg-white' : 'border-transparent bg-white/60 hover:bg-white' }}">
                            <input type="radio" name="editScope" data-model="editScope" value="series" class="mt-0.5 w-4 h-4 text-indigo-600" />
                            <span>
                                <span class="block text-sm font-bold text-slate-800">{{ 'admin.workshop_editor.scope.series'|trans }}</span>
                                <span class="block text-xs text-slate-500">{{ 'admin.workshop_editor.scope.series_hint'|trans({ count: this.getUpcomingSeriesLessonsCount() }) }}</span>
                            </span>
                        </label>
                    </div>
                </div>
            {% endif %}

            <!-- Tabs -->
            <div class="flex px-4 sm:px-6 border-b border-slate-200 bg-slate-50 overflow-x-auto shrink-0">
                <button
                    data-action="live#update"
                    data-model="activeTab"
                    data-value="general"
                    style="padding: 0.75rem 1rem;" class="px-3 sm:px-4 py-3 text-sm font-bold border-b-2 transition whitespace-nowrap {{ activeTab == 'general' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700' }}"
                >
                    Podstawowe
                </button>
                <button
                    data-action="live#update"
                    data-model="activeTab"
                    data-value="schedule"
                    style="padding: 0.75rem 1rem;" class="px-3 sm:px-4 py-3 text-sm font-bold border-b-2 transition whitespace-nowrap {{ activeTab == 'schedule' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700' }}"
                >
                    {{ editingLessonId ? 'Termin'|trans : 'Harmonogram i Cykliczność' }}
                </button>
                <button
                    data-action="live#update"
                    data-model="activeTab"
                    data-value="tickets"
                    style="padding: 0.75rem 1rem;" class="px-3 sm:px-4 py-3 text-sm font-bold border-b-2 transition whitespace-nowrap {{ activeTab == 'tickets' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700' }}"
                >
                    Bilety, Karnety i Zasady
                </button>
                <button
                    data-action="live#update"
                    data-model="activeTab"
                    data-value="instructors"
                    style="padding: 0.75rem 1rem;" class="px-3 sm:px-4 py-3 text-sm font-bold border-b-2 transition whitespace-nowrap {{ activeTab == 'instructors' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700' }}"
                >
                    Prowadzący
                </button>
            </div>

            <!-- Form Body - Scrollable -->
            <div class="p-6 overflow-y-auto custom-scrollbar flex-1">

                <!-- TAB: GENERAL -->
                {% if activeTab == 'general' %}
                    <div class="space-y-5">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5 col-span-2 md:col-span-1">
                                <label class="text-sm font-bold text-slate-700">Nazwa warsztatów *</label>
                                <input
                                    type="text"
                                    data-model="title"
                                    value="{{ title|default('') }}"
                                    placeholder="np. Błotna Kuchnia"
                                    class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                                />
                            </div>
                            <div class="space-y-1.5 col-span-2 md:col-span-1">
                                <label class="text-sm font-bold text-slate-700">Kategoria *</label>
                                <select
                                    data-model="category"
                                    class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                >
                                    <option value="">Wybierz kategorię...</option>
                                    {% for cat in this.getCategories() %}
                                        <option value="{{ cat }}" {{ category == cat ? 'selected' : '' }}>{{ cat }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5">
                                <label class="text-sm font-bold text-slate-700">Przedział wiekowy</label>
                                <div class="flex items-center gap-2">
                                    <input
                                        type="number"
                                        data-model="ageMin"
                                        value="{{ ageMin|default('') }}"
                                        placeholder="0"
                                        class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                    />
                                    <span class="text-slate-400">-</span>
                                    <input
                                        type="number"
                                        data-model="ageMax"
                                        value="{{ ageMax|default('') }}"
                                        placeholder="10"
                                        class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                    />
                                    <span class="text-sm text-slate-500">lat</span>
                                </div>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-sm font-bold text-slate-700">Limit miejsc (pojemność sali)</label>
                                <input
                                    type="number"
                                    data-model="capacity"
                                    value="{{ capacity|default(10) }}"
                                    class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                />
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-sm font-bold text-slate-700">Opis (widoczny dla klientów) *</label>
                            <textarea
                                data-model="description"
                                rows="4"
                                class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                placeholder="Opisz co będzie się dziać..."
                            >{{ description|default('') }}</textarea>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5">
                                <label class="text-sm font-bold text-slate-700">Krótki opis (lead)</label>
                                <input
                                    type="text"
                                    data-model="lead"
                                    value="{{ lead|default('') }}"
                                    placeholder="Krótki opis w jednym zdaniu"
                                    class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                />
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-sm font-bold text-slate-700">Kolor motywu</label>
                                <input
                                    type="color"
                                    data-model="visualTheme"
                                    value="{{ visualTheme matches '/^#[0-9a-fA-F]{6}$/' ? visualTheme : '#f97316' }}"
                                    class="w-full h-11 p-1 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none"
                                />
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-sm font-bold text-slate-700">Zdjęcie warsztatu</label>

                            {% if this.getEditingLessonImageUrl() %}
                                <div class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl">
                                    <img src="{{ this.getEditingLessonImageUrl() }}" alt="" class="w-16 h-16 rounded-lg object-cover shrink-0" />
                                    <label class="flex items-center gap-2 text-xs font-bold text-red-600 cursor-pointer">
                                        <input type="checkbox" data-model="removeImage" class="w-4 h-4 rounded text-red-600" />
                                        Usuń obecne zdjęcie
                                    </label>
                                </div>
                            {% endif %}

                            <div data-controller="image-upload"
                                 data-action="dropzone:clear->image-upload#clearPreview">
                                <div class="dropzone-container" data-controller="symfony--ux-dropzone--dropzone">
                                    <input type="file" accept="image/*" name="imageFile"
                                           data-symfony--ux-dropzone--dropzone-target="input"
                                           data-image-upload-target="input"
                                           data-action="change->image-upload#optimize"
                                           class="dropzone-input" />
                                    <div class="dropzone-placeholder" data-symfony--ux-dropzone--dropzone-target="placeholder">
                                        Przeciągnij i upuść zdjęcie lub kliknij, aby wybrać
                                    </div>
                                    <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview" style="display: none">
                                        <button class="dropzone-preview-button" type="button"
                                                data-symfony--ux-dropzone--dropzone-target="previewClearButton"></button>
                                        <div class="dropzone-preview-image" style="display: none"
                                             data-symfony--ux-dropzone--dropzone-target="previewImage"></div>
                                        <div data-symfony--ux-dropzone--dropzone-target="previewFilename" class="dropzone-preview-filename"></div>
                                    </div>
                                </div>
                                <div class="mt-3 flex items-start gap-3">
                                    <img data-image-upload-target="preview" alt="" hidden
                                         class="w-32 h-24 rounded-xl object-cover border border-slate-200 bg-slate-50" />
                                    <div class="min-w-0 pt-1 text-xs">
                                        <p data-image-upload-target="status" class="text-slate-500"></p>
                                        <p data-image-upload-target="details" class="mt-1 font-semibold text-slate-700"></p>
                                        <p class="mt-1 text-slate-400">Zdjęcie zostanie zmniejszone do maks. 1920 px i zapisane jako WebP.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- TAB: SCHEDULE -->
                {% if activeTab == 'schedule' %}
                    {% if editingLessonId %}
                        <div class="space-y-6">
                            <div class="space-y-4 border border-slate-200 p-5 rounded-xl">
                                <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    {{ 'admin.workshop_editor.this_occurrence'|trans }}
                                </h3>
                                <p class="text-xs text-slate-500">{{ 'admin.workshop_editor.occurrence_date_hint'|trans }}</p>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                    <div class="space-y-1.5">
                                        <label class="text-sm font-bold text-slate-700">Data</label>
                                        <input
                                            type="date"
                                            data-model="occurrenceDate"
                                            value="{{ occurrenceDate|default('') }}"
                                            class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                        />
                                    </div>
                                    <div class="space-y-1.5">
                                        <label class="text-sm font-bold text-slate-700">Godzina</label>
                                        <input
                                            type="time"
                                            data-model="occurrenceTime"
                                            value="{{ occurrenceTime|default('') }}"
                                            class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                        />
                                    </div>
                                </div>
                            </div>
                            {% if this.getEditingSeries() and is_granted('ROLE_MANAGE_SCHEDULE') %}
                                <div class="space-y-2 border border-slate-200 p-5 rounded-xl">
                                    <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                        {{ 'admin.workshop_editor.last_occurrence.label'|trans }}
                                    </h3>
                                    <p class="text-xs text-slate-500">{{ 'admin.workshop_editor.last_occurrence.hint'|trans }}</p>
                                    {% if endDate == 'now'|date('Y-m-d') %}
                                        <p class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-2">{{ 'admin.workshop_editor.last_occurrence.ending_today_hint'|trans }}</p>
                                    {% endif %}
                                    <input
                                        type="date"
                                        data-model="endDate"
                                        value="{{ endDate|default('') }}"
                                        class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                    />
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                    <div class="space-y-6">
                        <div class="p-4 rounded-xl border-2 border-indigo-100 bg-indigo-50/50 flex gap-4">
                            <div class="flex-1">
                                <label class="flex items-center gap-2 text-sm font-bold text-indigo-900 mb-1">
                                    <input
                                        type="radio"
                                        name="scheduletype"
                                        data-model="scheduleType"
                                        value="single"
                                        class="w-4 h-4 text-indigo-600"
                                    /> Wydarzenie jednorazowe
                                </label>
                                <p class="text-xs text-indigo-700 ml-6">Klasyczne zajęcia w konkretnym dniu.</p>
                            </div>
                            <div class="flex-1">
                                <label class="flex items-center gap-2 text-sm font-bold text-indigo-900 mb-1">
                                    <input
                                        type="radio"
                                        name="scheduletype"
                                        data-model="scheduleType"
                                        value="recurring"
                                        class="w-4 h-4 text-indigo-600"
                                        checked
                                    /> Cykliczne (Powtarzalne)
                                </label>
                                <p class="text-xs text-indigo-700 ml-6">Tworzy serię wydarzeń np. co tydzień.</p>
                            </div>
                        </div>

                        <div class="space-y-4 border border-slate-200 p-5 rounded-xl">
                            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                                Konfiguracja Cyklu
                            </h3>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div class="space-y-1.5">
                                    <label class="text-sm font-bold text-slate-700">Dzień tygodnia</label>
                                    <select
                                        data-model="dayOfWeek"
                                        class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                    >
                                        <option value="">Wybierz dzień...</option>
                                        {% for dayKey, dayLabel in this.getDaysOfWeek() %}
                                            <option value="{{ dayKey }}" {{ dayOfWeek == dayKey ? 'selected' : '' }}>{{ dayLabel }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="space-y-1.5">
                                    <label class="text-sm font-bold text-slate-700">Godzina (Od - Do)</label>
                                    <div class="flex items-center gap-2">
                                        <input
                                            type="time"
                                            data-model="startTime"
                                            value="{{ startTime|default('10:00') }}"
                                            class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                        />
                                        <span class="text-slate-400">-</span>
                                        <input
                                            type="time"
                                            data-model="endTime"
                                            value="{{ endTime|default('11:30') }}"
                                            class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                        />
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                                <div class="space-y-1.5">
                                    <label class="text-sm font-bold text-slate-700">Początek cyklu</label>
                                    <input
                                        type="date"
                                        data-model="startDate"
                                        class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                    />
                                </div>
                                <div class="space-y-1.5">
                                    <label class="text-sm font-bold text-slate-700">Zakończenie cyklu (opcjonalne)</label>
                                    <input
                                        type="date"
                                        data-model="endDate"
                                        class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
                                    />
                                </div>
                            </div>

                            <div class="pt-2">
                                <label class="flex items-center gap-2 text-sm font-bold text-slate-700 cursor-pointer">
                                    <input
                                        type="checkbox"
                                        data-model="skipHolidays"
                                        class="w-4 h-4 rounded text-indigo-600"
                                        checked
                                    />
                                    Omijaj dni ustawowo wolne od pracy (święta)
                                </label>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                {% endif %}

                <!-- TAB: TICKETS -->
                {% if activeTab == 'tickets' %}
                    <div class="space-y-6">
                        <div class="p-4 rounded-xl border-2 border-indigo-100 bg-indigo-50/50">
                            <h3 class="font-bold text-indigo-900 mb-2">Metody płatności</h3>
                            <label class="flex items-center gap-2 text-sm font-bold text-indigo-800 cursor-pointer">
                                <input
                                    type="checkbox"
                                    data-model="allowPayOnPlace"
                                    class="w-4 h-4 rounded text-indigo-600"
                                />
                                Włącz opcję "Płatność na miejscu" (wymaga akceptacji przez prowadzącego/admina)
                            </label>
                            <p class="text-xs text-indigo-700 mt-1 ml-6">
                                Rezerwacje z tą opcją będą wymagały ręcznej akceptacji przed zajęciami.
                            </p>
                        </div>

                        <div class="space-y-4 border border-slate-200 p-5 rounded-xl">
                            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                Cennik
                            </h3>

                            <div class="space-y-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-32 text-sm font-bold text-slate-700">Jednorazowe</div>
                                    <div class="flex-1 relative">
                                        <input
                                            type="text"
                                            inputmode="decimal"
                                            data-controller="money-input"
                                            data-action="input->money-input#sanitize"
                                            data-model="singleTicketPrice"
                                            value="{{ singleTicketPrice|default('') }}"
                                            placeholder="55,00"
                                            class="w-full p-2 pr-9 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none"
                                        />
                                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">zł</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="w-32 text-sm font-bold text-slate-700">Karnet 4 wejścia</div>
                                    <div class="flex-1 relative">
                                        <input
                                            type="text"
                                            inputmode="decimal"
                                            data-controller="money-input"
                                            data-action="input->money-input#sanitize"
                                            data-model="carnet4Price"
                                            value="{{ carnet4Price|default('') }}"
                                            placeholder="200,00"
                                            class="w-full p-2 pr-9 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none"
                                        />
                                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">zł</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- TAB: INSTRUCTORS -->
                {% if activeTab == 'instructors' %}
                    <div class="space-y-6">
                        <div class="space-y-4">
                            <div class="relative">
                                <input
                                    type="text"
                                    data-model="on(input)|instructorSearch"
                                    value="{{ instructorSearch|default('') }}"
                                    placeholder="Szukaj po imieniu, nazwisku lub e-mailu..."
                                    autocomplete="off"
                                    class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                                />
                                {% if instructorSearch and instructorSearch|length >= 2 %}
                                    <div class="absolute z-10 mt-1 w-full bg-white border border-slate-200 rounded-xl shadow-lg max-h-56 overflow-y-auto">
                                        {% for user in this.getFilteredInstructors() %}
                                            <button
                                                type="button"
                                                data-action="live#action" data-live-action-param="addInstructor" data-live-user-id-param="{{ user.id }}"
                                                class="w-full text-left px-4 py-2.5 hover:bg-slate-50 transition border-b border-slate-100 last:border-0"
                                            >
                                                <div class="text-sm font-bold text-slate-800">{{ user.name }}</div>
                                                <div class="text-xs text-slate-500">{{ user.email }}</div>
                                            </button>
                                        {% else %}
                                            <div class="px-4 py-3 text-sm text-slate-400">Brak wyników</div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            {% for user in this.getInstructors() %}
                                <div class="flex justify-between items-center bg-slate-50 p-3 rounded-lg border border-slate-200">
                                    <div>
                                        <div class="font-bold text-sm text-slate-800">{{ user.name }}</div>
                                        <div class="text-xs text-slate-500">{{ user.email }}</div>
                                    </div>
                                    <button
                                        data-action="live#action" data-live-action-param="removeInstructor" data-live-user-id-param="{{ user.id }}"
                                        class="text-red-500 hover:bg-red-50 p-1.5 rounded-lg transition"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                    </button>
                                </div>
                            {% else %}
                                <div class="text-sm text-slate-500 text-center py-4 bg-slate-50 rounded-lg border border-slate-200">
                                    Brak przypisanych prowadzących
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            <!-- Footer -->
            <div class="p-4 sm:p-6 border-t border-slate-100 bg-white flex flex-col-reverse sm:flex-row justify-end gap-3 rounded-b-2xl shrink-0">
                <button
                    data-action="live#action" data-live-action-param="close"
                    class="px-6 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition"
                >
                    Anuluj
                </button>
                <button
                    data-action="live#action" data-live-action-param="files|save"
                    class="px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-md transition"
                >
                    {{ editingLessonId ? 'admin.workshop_editor.save_edit'|trans : 'admin.workshop_editor.save_create'|trans }}
                </button>
            </div>
        </div>
    </div>
{% endif %}
</div>
