<div {{ attributes }} class="contents">
    {% set kpi = this.getKpiStats() %}
    {# Month navigation — available to every admin #}
    <div class="col-span-full order-first flex items-center gap-2 text-sm" data-testid="kpi-month-nav">
        <button type="button" data-action="live#action" data-live-action-param="previousMonth"
                class="rounded-full border border-slate-200 bg-white px-3 py-1 font-semibold text-slate-600 hover:bg-slate-50"
                aria-label="Poprzedni miesiąc">&larr;</button>
        <span class="font-bold text-slate-700 min-w-24 text-center">{{ kpi.monthLabel }} {{ this.monthKey|slice(0, 4) }}</span>
        <button type="button" data-action="live#action" data-live-action-param="nextMonth"
                class="rounded-full border border-slate-200 bg-white px-3 py-1 font-semibold text-slate-600 hover:bg-slate-50"
                aria-label="Następny miesiąc">&rarr;</button>
        {% if not this.isCurrentMonth %}
            <button type="button" data-action="live#action" data-live-action-param="currentMonth"
                    class="text-xs font-semibold text-slate-500 underline">Bieżący miesiąc</button>
        {% endif %}
        {% if is_granted('ACCOUNTING_REPORT_VIEW') %}
            <a href="{{ path('app_admin_accounting_report', {month: this.monthKey}) }}" target="_blank" rel="noopener"
               class="ml-auto rounded-full bg-slate-800 px-4 py-1 text-xs font-bold text-white hover:bg-slate-700">
                Zestawienie do druku
            </a>
        {% endif %}
    </div>

    {# KPI 1: Reservations #}
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col justify-between h-40">
        <div class="flex items-center justify-between gap-2">
            <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Rezerwacje ({{ kpi.monthLabel }})</h4>
            {{ include('admin/help/_context_button.html.twig', {slug: 'pulpit', label: 'Pulpit i wskaźniki'}) }}
        </div>
        <div class="text-4xl font-black text-slate-800 tracking-tight mb-2">{{ kpi.bookingsCount }}</div>
        <div class="text-xs text-slate-400 font-medium">Zarejestrowane rezerwacje</div>
    </div>

    {# KPI 2: Revenue #}
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col justify-between h-40">
        <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Przychód ({{ kpi.monthLabel }})</h4>
        <div class="text-4xl font-black text-slate-800 tracking-tight mb-2">{{ kpi.revenue|money }}</div>
        <div class="text-xs text-slate-400 font-medium">Suma opłaconych rezerwacji</div>
    </div>

    {# KPI 3: Occupancy #}
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col justify-between h-40">
        <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Średnia zajętość</h4>
        <div class="text-4xl font-black text-slate-800 tracking-tight mb-2">{{ kpi.occupancyRate }}</div>
        <div class="text-xs text-slate-400 font-medium">Średnia zajętość zajęć</div>
    </div>
</div>
