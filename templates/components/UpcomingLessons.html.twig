{# templates/components/LessonSearch.html.twig #}
<div {{ attributes }}>
    {% if this.showSearch %}
        <div class="mb-8 bg-white p-6 rounded-xl shadow-sm">
            <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-grow">
                    <input
                            type="text"
                            class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm input-styled"
                            placeholder="{{ 'lesson.search'|trans }}"
                            value="{{ this.query }}"
                            data-model="query"
                    >
                </div>
                <div class="w-full md:w-40">
                    <input
                            type="number"
                            class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm input-styled"
                            placeholder="{{ 'lesson.age'|trans }}"
                            min="0"
                            max="99"
                            value="{{ this.age }}"
                            data-model="age"
                    >
                </div>
                <div class="flex md:w-auto"
                     data-controller="view-preference">
                    <div role="tablist" aria-orientation="horizontal"
                         class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground grid w-full grid-cols-2"
                         tabindex="0" style="outline: none;">
                        <button type="button" role="tab"
                                aria-selected="{{ this.view == 'grid' ? 'true' : 'false' }}"
                                data-state="{{ this.view == 'grid' ? 'active' : 'inactive' }}"
                                data-action="live#action click->view-preference#toggle"
                                data-live-action-param="setView"
                                data-live-view-param="grid"
                                class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-grid3x3 h-4 w-4 mr-1">
                                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                <path d="M3 9h18"></path>
                                <path d="M3 15h18"></path>
                                <path d="M9 3v18"></path>
                                <path d="M15 3v18"></path>
                            </svg>
                            {{ 'view.grid'|trans }}
                        </button>
                        <button type="button" role="tab"
                                aria-selected="{{ this.view == 'calendar' ? 'true' : 'false' }}"
                                data-state="{{ this.view == 'calendar' ? 'active' : 'inactive' }}"
                                data-action="live#action click->view-preference#toggle"
                                data-live-action-param="setView"
                                data-live-view-param="calendar"
                                class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-calendar h-4 w-4 mr-1">
                                <path d="M8 2v4"></path>
                                <path d="M16 2v4"></path>
                                <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                <path d="M3 10h18"></path>
                            </svg>
                            {{ 'view.calendar'|trans }}
                        </button>
                    </div>
                </div>
            </div>
            <input type="hidden" data-model="view" value="{{ this.view }}">
        </div>
    {% endif %}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <h1 class="text-3xl font-bold">{{ 'page.workshops'|trans }}</h1>
        {% if this.showSearch %}
            <div class="flex flex-wrap items-center gap-2">
                <button
                        type="button"
                        data-model="week"
                        data-value="{{ this.week|date_modify('-7 days')|date('Y-m-d') }}"
                        data-action="live#update"
                        class="px-3 py-1.5 border rounded-md hover:bg-gray-50 flex items-center text-sm"
                >
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                         xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 19l-7-7 7-7"></path>
                    </svg>
                    {{ 'lesson.previous_week'|trans }}
                </button>
                <span class="px-3 py-1.5 text-sm bg-gray-100 rounded-md whitespace-nowrap">
                {{ this.weekStart|format_date('medium') }} - {{ this.weekEnd|format_date('medium') }}
            </span>
                <button
                        type="button"
                        data-model="week"
                        data-value="{{ this.week|date_modify('+7 days')|date('Y-m-d') }}"
                        data-action="live#update"
                        class="px-3 py-1.5 border rounded-md hover:bg-gray-50 flex items-center text-sm"
                >
                    {{ 'lesson.next_week'|trans }}
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                         xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
                {% if this.weekStart.format('Y-m-d') != this.currentWeek|date('Y-m-d') %}
                    <button
                            type="button"
                            data-model="week"
                            data-value="{{ this.currentWeek|date('Y-m-d') }}"
                            data-action="live#update"
                            class="px-3 py-1.5 text-sm border rounded-md hover:bg-gray-50 whitespace-nowrap"
                    >
                        {{ 'lesson.current_week'|trans }}
                    </button>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% set userBookings = this.getUserBookingsByLesson() %}

    {% if this.view == 'calendar' %}
        <div class="calendar-view-container">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold font-display flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-calendar mr-2 h-5 w-5 text-workshop-red">
                        <path d="M8 2v4"></path>
                        <path d="M16 2v4"></path>
                        <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                        <path d="M3 10h18"></path>
                    </svg>
                    <span>{{ 'view.week_of'|trans }} {{ this.weekStart|format_date('medium') }}</span>
                </h2>
            </div>
            <div class="grid grid-flow-col auto-cols-[190px] gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-4 pb-3">
                {% for dayData in this.getWorkshopsByDay() %}
                    {% set isToday = dayData.date|date('Y-m-d') == "now"|date('Y-m-d') %}
                    <div class="day-column snap-start rounded-2xl border overflow-hidden shadow-sm flex flex-col {{ isToday ? 'border-workshop-red/40 ring-1 ring-workshop-red/20' : 'border-muted' }}">
                        <div class="p-3 text-center font-medium {{ isToday ? 'bg-workshop-red text-white' : 'bg-muted text-foreground' }}">
                            <div>{{ ('day.' ~ dayData.weekday)|trans }}</div>
                            <div class="text-xs {{ isToday ? 'text-white/80' : 'text-muted-foreground' }}">{{ dayData.date|format_date('short') }}</div>
                        </div>
                        <div class="day-content flex-1 min-h-[300px] bg-white p-3">
                            {% if dayData.workshops is empty %}
                                <div class="h-full min-h-[260px] flex flex-col items-center justify-center text-center gap-2 text-muted-foreground/60">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M8 2v4"></path>
                                        <path d="M16 2v4"></path>
                                        <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                        <path d="M3 10h18"></path>
                                    </svg>
                                    <span class="text-xs">{{ 'lesson.no_lessons_found'|trans }}</span>
                                </div>
                            {% else %}
                                <div class="space-y-2.5">
                                    {% for lesson in dayData.workshops %}
                                        {% set workshopUrl = lesson.metadata.slug
                                            ? path('workshop_by_slug', {slug: lesson.metadata.slug, date: lesson.metadata.schedule|date('Y-m-d'), hour: lesson.metadata.schedule|date('H:i')})
                                            : path('workshops', {week: lesson.metadata.schedule|date('Y-m-d')}) %}
                                        <div class="relative rounded-xl border bg-card text-card-foreground shadow-sm pl-4 pr-3 py-3 pb-8 hover:shadow-md transition-shadow">
                                            <div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-xl" style="background-color: {{ lesson.metadata.visualTheme }};"></div>
                                            <div class="text-sm font-medium">
                                                <a href="{{ workshopUrl }}" class="hover:underline">{{ lesson.metadata.title }}</a>
                                            </div>
                                            <div class="text-xs text-muted-foreground">
                                                {{ lesson.metadata.schedule|date('H:i') }}-{{ lesson.metadata.schedule|date_modify('+' ~ lesson.metadata.duration ~ ' minutes')|date('H:i') }}
                                            </div>
                                            {% set lessonBookings = userBookings[lesson.id]|default([]) %}
                                            {% if lessonBookings is not empty %}
                                                <div class="flex flex-wrap gap-1 mt-1">
                                                    {% for bookingInfo in lessonBookings %}
                                                        {% if bookingInfo.paymentStatus == 'paid' %}
                                                            <span class="inline-flex items-center rounded-full border bg-green-50 border-green-200 text-green-700 px-1.5 py-0.5 text-xs font-semibold">
                                                                {% if bookingInfo.childName %}{{ bookingInfo.childName }} • {% endif %}{{ 'admin.badges.paid'|trans }}
                                                            </span>
                                                        {% else %}
                                                            <span class="inline-flex items-center rounded-full border bg-gray-50 border-gray-200 text-gray-600 px-1.5 py-0.5 text-xs font-semibold">
                                                                {% if bookingInfo.childName %}{{ bookingInfo.childName }} • {% endif %}{{ 'admin.badges.unpaid'|trans }}
                                                            </span>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                            {% if lesson.getAvailableSpots() <= 3 %}
                                                <div class="inline-flex items-center rounded-full border mt-1 text-xs border-workshop-red text-workshop-red {% if lesson.getAvailableSpots() == 0 %}bg-workshop-red/10{% endif %} px-2 py-0.5 font-semibold">
                                                    {{ 'lesson.spots_available'|trans({spots: lesson.getAvailableSpots()}) }}
                                                </div>
                                            {% endif %}
                                            {{ component('LessonModal', {
                                                lesson: lesson,
                                                modalOpened: this.shouldOpenModal(lesson),
                                                closeUrl: this.showSearch
                                                    ? path('workshops', {week: lesson.metadata.schedule|date('Y-m-d')})
                                                    : path('homepage')
                                            }) }}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for lesson in this.workshops %}
            <div class="workshop-card">
                {% include "components/CapacityBadge.html.twig" with {'capacity': lesson.metadata.capacity, 'available': lesson.availableSpots } %}
                <div class="rounded-lg bg-white shadow-sm h-full flex flex-col">
                    {% set workshopUrl = lesson.metadata.slug
                        ? path('workshop_by_slug', {slug: lesson.metadata.slug, date: lesson.metadata.schedule|date('Y-m-d'), hour: lesson.metadata.schedule|date('H:i')})
                        : path('workshops', {week: lesson.metadata.schedule|date('Y-m-d')}) %}
                    <a href="{{ workshopUrl }}" class="block h-48 bg-cover bg-center rounded-t-lg"
                         style="background-color: {{ lesson.metadata.visualTheme }}; background-image: none; border-top-left-radius: 12px; border-top-right-radius: 12px;"></a>
                    <div class="p-6 flex flex-col flex-grow">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xl font-bold font-display"><a href="{{ workshopUrl }}" class="hover:underline">{{ lesson.metadata.title }}</a></h3>
                            <span class="text-sm font-medium text-workshop-red">{{ lesson.defaultTicketOption.price|money }}</span>
                        </div>
                        {% set lessonBookings = userBookings[lesson.id]|default([]) %}
                        {% if lessonBookings is not empty %}
                            <div class="flex flex-wrap gap-2 mb-3">
                                {% for bookingInfo in lessonBookings %}
                                    {% if bookingInfo.paymentStatus == 'paid' %}
                                        <span class="inline-flex items-center rounded-full border bg-green-50 border-green-200 text-green-700 px-2.5 py-0.5 text-xs font-semibold">
                                            {% if bookingInfo.childName %}{{ bookingInfo.childName }} • {% endif %}{{ 'admin.badges.paid'|trans }}
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center rounded-full border bg-gray-50 border-gray-200 text-gray-600 px-2.5 py-0.5 text-xs font-semibold">
                                            {% if bookingInfo.childName %}{{ bookingInfo.childName }} • {% endif %}{{ 'admin.badges.unpaid'|trans }}
                                        </span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <p class="text-sm text-muted-foreground mb-4">{{ lesson.metadata.lead }}</p>
                        <div class="mt-auto space-y-3">
                            <div class="flex items-center text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="lucide lucide-calendar w-4 h-4 mr-2 text-workshop-red">
                                    <path d="M8 2v4"></path>
                                    <path d="M16 2v4"></path>
                                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                    <path d="M3 10h18"></path>
                                </svg>
                                <span>
                                    {% if lesson.series and lesson.series.type.value == 'weekly' %}
                                        {{ 'lesson.every'|trans({
                                            'day': lesson.metadata.schedule|date('l'),
                                            'hour': lesson.metadata.schedule|date('H:i')
                                        }) }}
                                    {% else %}
                                        {{ 'lesson.once'|trans({
                                            'day': lesson.metadata.schedule|date('l'),
                                            'date': lesson.metadata.schedule|date('d.m.Y')|format_datetime(pattern: 'd MMMM'),
                                            'hour': lesson.metadata.schedule|date('H:i')
                                        }) }}
                                    {% endif %}
                                </span>
                            </div>
                            <div class="flex items-center text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="lucide lucide-clock w-4 h-4 mr-2 text-workshop-blue">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <span>{{ 'lesson.minutes'|trans({minutes: lesson.metadata.duration}) }}</span>
                            </div>
                            <div class="flex items-center text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="lucide lucide-users w-4 h-4 mr-2 text-workshop-green">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                                <span>
                                    {{ lesson.metadata.ageRange.max
                                    ? 'lesson.age_range'|trans({min: lesson.metadata.ageRange.min, max: lesson.metadata.ageRange.max, top: lesson.metadata.ageRange.max})
                                    : 'lesson.age_above'|trans({min: lesson.metadata.ageRange.min}) }}
                                </span>
                            </div>
                            {{ component('LessonModal', {
                                lesson: lesson,
                                modalOpened: this.shouldOpenModal(lesson),
                                closeUrl: this.showSearch
                                    ? path('workshops', {week: lesson.metadata.schedule|date('Y-m-d')})
                                    : path('homepage')
                            }) }}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-3 text-center py-12">
                <p class="text-muted-foreground">{{ 'lesson.no_lessons_found'|trans }}</p>
            </div>
        {% endfor %}
    </div>
    {% endif %}
</div>