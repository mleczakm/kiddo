<div {{ attributes }} data-controller="live">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
        <div class="p-6 border-b border-slate-100 bg-slate-50 shrink-0 flex flex-col space-y-1.5">
            <h3 class="flex items-center gap-3 text-lg font-black text-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle text-indigo-600">
                    <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
                </svg>
                <span>Wiadomości od użytkowników</span>
                {% if this.unreadCount > 0 %}
                    <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">
                        {{ this.unreadCount }}
                    </span>
                {% endif %}
            </h3>
        </div>

        <div class="p-6">
            <!-- Filter Tabs -->
            <div class="flex space-x-1 mb-6 bg-slate-100 p-1 rounded-lg">
                <button
                    type="button"
                    class="flex-1 text-center px-3 py-2 text-sm font-medium rounded-md transition-colors {{ activeFilter == 'unread' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900' }}"
                    data-action="live#action"
                    data-live-action-param="changeFilter"
                    data-live-filter-param="unread"
                >
                    Nieprzeczytane
                    {% if this.unreadCount > 0 %}
                        <span class="ml-2 bg-red-100 text-red-600 py-0.5 px-2 rounded-full text-xs">{{ this.unreadCount }}</span>
                    {% endif %}
                </button>
                <button
                    type="button"
                    class="flex-1 text-center px-3 py-2 text-sm font-medium rounded-md transition-colors {{ activeFilter == 'in_progress' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900' }}"
                    data-action="live#action"
                    data-live-action-param="changeFilter"
                    data-live-filter-param="in_progress"
                >
                    W trakcie
                </button>
                <button
                    type="button"
                    class="flex-1 text-center px-3 py-2 text-sm font-medium rounded-md transition-colors {{ activeFilter == 'resolved' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900' }}"
                    data-action="live#action"
                    data-live-action-param="changeFilter"
                    data-live-filter-param="resolved"
                >
                    Rozwiązane
                </button>
                <button
                    type="button"
                    class="flex-1 text-center px-3 py-2 text-sm font-medium rounded-md transition-colors {{ activeFilter == 'all' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900' }}"
                    data-action="live#action"
                    data-live-action-param="changeFilter"
                    data-live-filter-param="all"
                >
                    Wszystkie
                </button>
            </div>

            <!-- Messages List -->
            <div class="space-y-4">
                {% for message in this.getFilteredMessages() %}
                    <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50 transition-colors cursor-pointer"
                         data-action="click->live#action"
                         data-live-action-param="openMessage"
                         data-live-message-id-param="{{ message.id }}">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold">
                                    {{ message.user.name|first|upper }}
                                </div>
                                <div>
                                    <div class="font-medium text-slate-900">{{ message.user.name }}</div>
                                    <div class="text-xs text-slate-500">{{ message.createdAt|date('Y-m-d H:i') }}</div>
                                </div>
                            </div>
                            {% if message.status == 'unread' %}
                                <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-medium text-red-700">
                                    Nowa
                                </span>
                            {% elseif message.status == 'in_progress' %}
                                <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-700">
                                    W trakcie
                                </span>
                            {% elseif message.status == 'resolved' %}
                                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-700">
                                    Rozwiązane
                                </span>
                            {% endif %}
                        </div>
                        <p class="text-sm text-slate-700 line-clamp-2">{{ message.content }}</p>
                    </div>
                {% else %}
                    <div class="text-center py-12 text-slate-500">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle mx-auto mb-4 text-slate-300">
                            <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
                        </svg>
                        <p class="font-medium">Brak wiadomości</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Message Detail Modal -->
    {% if this.selectedMessage %}
        <div data-action="click->live#action"
             data-live-action-param="closeMessage"
             class="fixed inset-0 z-50 bg-black/60"></div>
        <dialog open class="fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 gap-4 border bg-white p-6 shadow-lg duration-200 rounded-lg max-w-2xl max-h-[80vh] overflow-y-auto">
            <div class="flex justify-between items-start mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-lg">
                        {{ this.selectedMessage.user.name|first|upper }}
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900">{{ this.selectedMessage.user.name }}</h3>
                        <div class="text-sm text-slate-500">{{ this.selectedMessage.user.email }}</div>
                    </div>
                </div>
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="closeMessage"
                        class="text-slate-400 hover:text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </div>
            
            <div class="mb-6">
                <div class="text-sm text-slate-500 mb-2">{{ this.selectedMessage.createdAt|date('Y-m-d H:i') }}</div>
                <p class="text-slate-700 whitespace-pre-wrap">{{ this.selectedMessage.content }}</p>
            </div>

            <div class="border-t border-slate-200 pt-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Odpowiedź</label>
                <textarea class="w-full border border-slate-200 rounded-lg p-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                          rows="4"
                          data-model="replyContent"
                          placeholder="Wpisz odpowiedź..."></textarea>
                <div class="flex justify-end gap-2 mt-4">
                    <select class="border border-slate-200 rounded-lg px-3 py-2 text-sm" data-model="statusChange">
                        <option value="in_progress">Oznacz jako w trakcie</option>
                        <option value="resolved">Oznacz jako rozwiązane</option>
                    </select>
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="sendReply"
                            class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors">
                        Wyślij odpowiedź
                    </button>
                </div>
            </div>
        </dialog>
    {% endif %}
</div>
