<div
        {% if modalOpened %}data-modal-state="open"{% else %}data-modal-state="closed"{% endif %}
        {% set workshopUrl = lesson and lesson.metadata.slug
            ? path('workshop_by_slug', {slug: lesson.metadata.slug, date: lesson.schedule|date('Y-m-d'), hour: lesson.schedule|date('H:i'), week: week})
            : closeUrl %}
        {{ attributes.defaults(stimulus_controller('workshop-url', {
            openUrl: workshopUrl,
            closeUrl: closeUrl,
        })).defaults(
            paymentStatus == 'awaiting_payment' and paymentCode
                ? {'data-poll': 'delay(3000)|refreshPaymentStatus'}
                : {}
        ) }}
>

    {% if not hideOpenButton %}
    <button data-action="live#action click->workshop-url#pushOpen"
            data-live-action-param="openModal"
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 w-full bg-workshop-red text-white hover:bg-workshop-red/90 hover:scale-105 transition-transform duration-200 active:scale-95 relative z-10"
            type="button">{{ 'lesson.details'|trans }}
    </button>
    {% endif %}

    {% if modalOpened %}
    <div data-controller="modal-transition">
    {# Overlay #}
    <div
            data-modal-transition-target="overlay"
            data-state="open"
            data-action="click->modal-transition#close click->live#action click->workshop-url#pushClose"
            data-live-action-param="closeModal"
            class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
            style="pointer-events: auto;" aria-hidden="true"></div>

    {# Dialog #}
    <dialog open
            data-modal-target="dialog"
            data-modal-transition-target="panel"
            data-state="open"
            class="fixed inset-0 m-auto z-50 w-[calc(100%-2rem)] h-fit gap-4 border bg-background p-6 sm:p-10 shadow-lg duration-200 sm:rounded-2xl max-w-3xl max-h-[90vh] overflow-y-auto data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95">
        <div class="grid">
            {% if termsOpened %}
                <div class="flex flex-col space-y-2 text-center sm:text-left mb-6 h-[80vh]">
                    <object
                            data="{{ this.getTermsUrl() }}"
                            type="application/pdf"
                            width="100%"
                            height="100%"
                            style="min-height: 100%;"
                    >
                        <p>
                            Your browser does not support PDFs. [Download the
                            PDF]({{ this.getTermsUrl() }}) .
                        </p>
                    </object>
                </div>
                <div class="flex justify-end gap-4 mt-4">
                    <div class="flex flex-col sm:flex-row gap-4 mt-4">
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="closeTerms"
                                class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                            {{ 'lesson.cancel'|trans }}
                        </button>
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="acceptTermsAndClose"
                                class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 bg-workshop-red text-white hover:bg-workshop-red/90">
                            {{ 'booking.accept_terms_and_close'|trans }}
                        </button>
                    </div>
                </div>
            {% elseif paymentStatus == 'paid' %}
                <div class="flex flex-col items-center justify-center min-h-[300px]">
                    <div class="bg-white border border-green-200 rounded-lg shadow-md p-8 max-w-lg w-full text-center">
                        <div class="text-2xl font-bold text-green-700 mb-4">
                            {{ 'payment.paid_success'|trans }}
                        </div>
                        <div class="text-muted-foreground mb-4">{{ 'payment.paid_message'|trans }}</div>
                        <button type="button"
                                data-action="click->modal-transition#close click->live#action click->workshop-url#pushClose"
                                data-live-action-param="closeModal"
                                class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-green-50 h-10 px-4 py-2 border border-green-200 text-green-700">
                            {{ 'lesson.close'|trans }}
                        </button>
                    </div>
                </div>
            {% elseif paymentCode is not empty and this.paymentAmount is not empty %}
                <div class="flex flex-col items-center justify-center min-h-[300px]">
                    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 max-w-lg w-full text-center">
                        {% if paymentStatus == 'awaiting_payment' %}
                            <div class="text-sm text-muted-foreground mb-4">{{ 'payment.awaiting'|trans }}</div>
                        {% endif %}
                        <div class="text-2xl font-bold text-workshop-brown mb-4">
                            {{ 'blik.instruction'|trans }} <span
                                    class="text-workshop-red whitespace-nowrap"> {{ 'blik.phone'|trans }}</span>
                        </div>
                        <div class="text-lg mb-2">{{ 'blik.instruction_2'|trans }} <span
                                    class="text-workshop-red whitespace-nowrap">{{ this.paymentAmount|money }}</span>. {{ 'blik.instruction_3'|trans }}
                        </div>
                        <div class="text-2xl font-mono bg-gray-100 rounded p-4 mb-4 select-all tracking-widest text-workshop-red">{{ paymentCode }}</div>
                        <div class="text-muted-foreground text-sm mb-4">{{ 'blik.info'|trans }}</div>
                        <div class="text-muted-foreground text-sm border-t pt-4 mt-4">
                            {{ 'blik.alt_transfer'|trans({'title': paymentCode,'account': '<span class="text-workshop-red whitespace-nowrap">' ~ '46 2490 0005 0000 4000 1897 5420' ~ '</span>'})|raw }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="flex flex-col space-y-2 text-center sm:text-left mb-6 pr-8">
                    <h2 id="radix-:r1:" class="tracking-tight text-3xl font-bold font-display text-workshop-brown">
                        {{ lesson.metadata.title }}</h2>
                    <p id="radix-:r2:" class="text-sm text-muted-foreground">{{ lesson.metadata.lead }}</p>
                </div>

                {% if lesson.metadata.hasImage %}
                    <div class="rounded-2xl overflow-hidden bg-muted mb-8 flex justify-center">
                        {% if lesson.metadata.isVideo %}
                            <video src="{{ path('workshop_image', {id: lesson.id}) }}"
                                   autoplay muted loop playsinline
                                   aria-label="{{ lesson.metadata.title }}"
                                   class="max-h-[60vh] w-auto object-contain"></video>
                        {% else %}
                            <img src="{{ path('workshop_image', {id: lesson.id}) }}"
                                 alt="{{ lesson.metadata.title }}"
                                 class="max-h-[60vh] w-auto object-contain">
                        {% endif %}
                    </div>
                {% else %}
                    <div class="w-full h-40 sm:h-52 rounded-2xl mb-8" style="background-color: {{ lesson.metadata.safeVisualTheme }};"></div>
                {% endif %}

                {{ component('BookingPreviewComponent', {lesson: lesson}) }}
                <div class="space-y-8 mt-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-5">
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-calendar-check w-5 h-5 mr-3 text-workshop-red">
                                <path d="M8 2v4"></path>
                                <path d="M16 2v4"></path>
                                <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                <path d="M3 10h18"></path>
                                <path d="m9 16 2 2 4-4"></path>
                            </svg>
                            <div>
                                <p class="font-medium">{{ 'lesson.schedule'|trans }}</p>
                                <p class="text-muted-foreground">
                                    {{ 'lesson.once'|trans({
                                        'day': lesson.schedule|date('l'),
                                        'date': lesson.schedule|date('d.m.Y')|format_datetime(pattern: 'd MMMM'),
                                        'hour': lesson.schedule|date('H:i')
                                    }) }}
                                </p>
                                {% if lesson.series.type.value == 'weekly' %}
                                    <p class="text-xs text-muted-foreground/70">{{ 'lesson.repeats_weekly'|trans }}</p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-clock w-5 h-5 mr-3 text-workshop-blue">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <div>
                                <p class="font-medium">{{ 'lesson.duration'|trans }}</p>
                                <p class="text-muted-foreground">{{ 'lesson.minutes'|trans({minutes: lesson.metadata.duration}) }}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-users w-5 h-5 mr-3 text-workshop-green">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <div>
                                <p class="font-medium">{{ 'lesson.age_range_label'|trans }}</p>
                                <p class="text-muted-foreground">{{ lesson.metadata.ageRange.max ? 'lesson.age_range'|trans({min: lesson.metadata.ageRange.min, max: lesson.metadata.ageRange.max, top: lesson.metadata.ageRange.max}) : 'lesson.age_above'|trans({min: lesson.metadata.ageRange.min}) }}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-map-pin w-5 h-5 mr-3 text-workshop-yellow">
                                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <div>
                                <p class="font-medium">{{ 'lesson.location'|trans }}</p>
                                <p class="text-muted-foreground">{{ 'page.default.address.street'|trans }}
                                    , {{ 'page.default.address.city'|trans }}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-tag w-5 h-5 mr-3 text-workshop-pink">
                                <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path>
                                <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
                            </svg>
                            <div>
                                <p class="font-medium">{{ 'lesson.category'|trans }}</p>
                                <p class="text-muted-foreground">{{ lesson.metadata.category }}</p>
                            </div>
                        </div>
                        <div class="flex items-center">
                            <div class="inline-flex items-center rounded-full border font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 {{ lesson.getAvailableSpots() > 2 ? 'border-workshop-green text-workshop-green' : 'border-workshop-red text-workshop-red' }} text-base py-1 px-3">
                                {{ 'lesson.spots_available'|trans({spots: lesson.getAvailableSpots()}) }}
                            </div>
                        </div>
                    </div>

                    <div class="bg-muted/50 p-6 rounded-xl">
                        <h3 class="text-lg font-bold mb-3 font-display text-workshop-brown">{{ 'lesson.description'|trans }}</h3>
                        <div class="text-muted-foreground leading-7 [&_br]:block [&_br]:content-[''] [&_br]:mb-2">{{ lesson.metadata.description|raw|nl2br }}</div>
                    </div>
                    <div class="bg-muted/50 p-6 rounded-xl">
                        <h3 class="text-lg font-bold mb-4 font-display text-workshop-brown">
                            {{ 'lesson.booking_options'|trans }}</h3>

                        <div dir="ltr">
                            <div role="tablist" aria-orientation="horizontal"
                                 class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground w-full mb-4"
                                 tabindex="0" style="outline: none;">
                                {% for ticketOption in lesson.ticketOptions %}
                                    <button type="button" role="tab"
                                            aria-selected="{{ activeTabIndex == loop.index0 ? 'true' : 'false' }}"
                                            aria-controls="tabpanel-{{ loop.index }}"
                                            data-state="{{ activeTabIndex == loop.index0 ? 'active' : 'inactive' }}"
                                            class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm flex-1"
                                            data-action="live#action"
                                            data-live-action-param="selectTab"
                                            data-live-index-param="{{ loop.index0 }}"
                                            data-live-ticketType-param="{{ ticketOption.type.value }}"
                                    >
                                        {{ ('lesson.' ~ ticketOption.type.value)|trans }}
                                    </button>
                                {% endfor %}
                            </div>

                            {% set activeTicketOption = lesson.ticketOptions[activeTabIndex] %}
                            <div data-state="active" role="tabpanel"
                                 aria-labelledby="tab-{{ activeTabIndex }}"
                                 class="mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                                <div class="p-4 bg-background rounded-lg mb-4">
                                    <div class="flex justify-between items-center mb-2">
                                        <div>
                                            <h4 class="font-medium">{{ ('lesson.' ~ activeTicketOption.type.value)|trans }}</h4>
                                            <div class="text-muted text-sm mb-1">{{ activeTicketOption.description|raw }}</div>
                                            <div class="text-xs text-info">
                                                {% set policy = activeTicketOption.reschedulePolicy %}
                                                {% if policy == constant('App\\Entity\\TicketReschedulePolicy::ONETIME_24H_BEFORE') %}
                                                    {{ 'ticket.reschedule.onetime_24h'|trans|raw }}
                                                {% elseif policy == constant('App\\Entity\\TicketReschedulePolicy::UNLIMITED_24H_BEFORE') %}
                                                    {{ 'ticket.reschedule.unlimited_24h'|trans|raw }}
                                                {% else %}
                                                    {{ 'ticket.reschedule.not_allowed'|trans|raw }}
                                                {% endif %}
                                            </div>
                                        </div>
                                        <span class="text-lg font-bold">{{ (this.quotedPrice ?? activeTicketOption.price)|money }}</span>
                                    </div>
                                    <p class="text-sm text-muted-foreground mb-4">{{ ('lesson.' ~ activeTicketOption.type.value ~ '.description')|trans|raw|nl2br }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-4">
                    <div class="flex items-center {% if not termsAccepted and paymentStatus == 'error' %}border border-red-500 rounded bg-red-50 p-2{% endif %}">
                        <input type="checkbox" id="terms"
                               data-model="termsAccepted"
                               class="mr-2 h-4 w-4 rounded border-input text-workshop-red focus:ring-2 focus:ring-workshop-red/50">
                        <label for="terms"
                               class="text-sm text-muted-foreground">{{ 'lesson.accept_terms'|trans|raw }}</label>
                    </div>
                    <button type="button"
                            data-action="click->modal-transition#close click->live#action click->workshop-url#pushClose"
                            data-live-action-param="closeModal"
                            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                        {{ 'lesson.cancel'|trans }}
                    </button>
                    {% if app.user %}
                        <div class="flex flex-col sm:flex-row gap-2">
                            {% if not termsAccepted and lesson.canBeBooked() %}
                                <span class="inline-block" title="{{ 'lesson.accept_terms_first'|trans }}">
                                    <button type="button"
                                            disabled
                                            aria-disabled="true"
                                            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 pointer-events-none opacity-50 cursor-not-allowed [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 bg-workshop-red text-white">
                                    {{ 'lesson.book_and_pay'|trans }}
                                    </button>
                                </span>
                            {% elseif lesson.canBeBooked() %}
                                <button type="button"
                                        data-action="live#action"
                                        data-live-action-param="openPaymentModal"
                                        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-workshop-red/90 h-10 px-4 py-2 bg-workshop-red text-white [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0">
                                    {{ 'lesson.book_and_pay'|trans }}
                                </button>
                            {% else %}
                                <span class="inline-block" title="{{ 'lesson.fully_booked'|trans }}">
                                    <button type="button"
                                            disabled
                                            aria-disabled="true"
                                            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 pointer-events-none opacity-50 cursor-not-allowed [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 bg-workshop-red text-white">
                                    {{ 'lesson.book_and_pay'|trans }}
                                    </button>
                                </span>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="flex flex-col sm:flex-row gap-2">
                            <a href="{{ path('app_login') }}"
                               class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-4 py-2 bg-workshop-red text-white hover:bg-workshop-red/90">
                                {{ 'lesson.login'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>

                <button type="button"
                        data-action="click->modal-transition#close click->live#action click->workshop-url#pushClose"
                        data-live-action-param="closeModal"
                        class="absolute right-4 top-4 p-1.5 rounded-full hover:bg-gray-100 text-gray-500 hover:text-gray-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-x">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                    <span class="sr-only">{{ 'lesson.close'|trans }}</span>
                </button>
            {% endif %}
        </div>
    </dialog>
    </div>

    {% if paymentModal %}
    <div data-controller="modal-transition">
    <div data-modal-transition-target="overlay"
         data-state="open"
         data-action="click->modal-transition#close click->live#action"
         data-live-action-param="closePaymentModal"
         class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
         aria-hidden="true"></div>

    <div role="dialog"
         data-modal-transition-target="panel"
         data-state="open"
         class="fixed inset-0 m-auto z-50 w-[calc(100%-2rem)] h-fit grid max-w-lg max-h-[90vh] overflow-y-auto gap-4 border bg-background p-6 shadow-lg duration-200 sm:rounded-lg sm:max-w-[500px] data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95"
         tabindex="-1">
        <div class="flex flex-col space-y-1.5 text-center sm:text-left"><h2
                    class="tracking-tight text-xl font-bold font-display text-workshop-brown">{{ lesson.metadata.title }}</h2>
            <p class="text-sm text-muted-foreground">{{ 'booking.select_date'|trans }}</p>
        </div>
        <div class="space-y-4 py-2">
            <div class="bg-muted/50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-lg font-semibold">{{ lesson.schedule|format_datetime(pattern: 'd MMMM') }}</p>
                            <p class="text-sm text-muted-foreground">{{ lesson.schedule|date('H:i') }}
                                - {{ lesson.schedule|date_modify('+' ~ lesson.metadata.duration ~ ' minutes')|date('H:i') }}</p>
                        </div>
                        <div class="flex items-center gap-2"></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button
                                data-action="live#action"
                                data-live-action-param="previousLesson"
                                class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 rounded-md px-3"
                                {{ this.hasPreviousLesson ? '' : 'disabled' }}
                        >

                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-chevron-left w-4 h-4">
                                <path d="m15 18-6-6 6-6"></path>
                            </svg>
                        </button>
                        <button
                                data-action="live#action"
                                data-live-action-param="nextLesson"
                                class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 rounded-md px-3"
                                {{ this.hasNextLesson ? '' : 'disabled' }}
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-chevron-right w-4 h-4">
                                <path d="m9 18 6-6-6-6"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                {#                    <div class="flex items-center justify-between"> #}
                {#                        <span class="font-medium">{{ 'lesson.title'|trans }}</span> #}
                {#                        <span>{{ lesson.metadata.title }}</span> #}
                {#                    </div> #}
                {% if isFeatureEnabled('location') %}
                    <div class="flex items-center justify-between">
                        <span class="font-medium">Location:</span>
                        <span>Dance Room</span>
                    </div>
                {% endif %}
                <div dir="ltr" data-orientation="horizontal" class="w-full mt-4">
                    <div role="tablist" aria-orientation="horizontal"
                         class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground w-full mb-4"
                         tabindex="0" style="outline: none;">
                        {% for ticketOption in lesson.ticketOptions %}
                            <button type="button" role="tab"
                                    aria-selected="{{ activeTabIndex == loop.index0 ? 'true' : 'false' }}"
                                    aria-controls="tabpanel-{{ loop.index }}"
                                    data-state="{{ activeTabIndex == loop.index0 ? 'active' : 'inactive' }}"
                                    class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm flex-1"
                                    data-action="live#action"
                                    data-live-action-param="selectTab"
                                    data-live-index-param="{{ loop.index0 }}"
                                    data-live-ticketType-param="{{ ticketOption.type.value }}"
                            >
                                {{ ('lesson.' ~ ticketOption.type.value)|trans }}
                            </button>
                        {% endfor %}
                    </div>

                    {% set activeTicketOption = lesson.ticketOptions[activeTabIndex] %}
                    <div data-state="active" role="tabpanel"
                         aria-labelledby="tab-{{ activeTabIndex }}"
                         class="mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                        <div class="p-4 bg-background rounded-lg mb-4">
                            <div class="flex justify-between items-center mb-2">
                                <div>
                                    <h4 class="font-medium">{{ ('lesson.' ~ activeTicketOption.type.value)|trans }}</h4>
                                    <div class="text-muted text-sm mb-1">{{ activeTicketOption.description|raw|nl2br }}</div>
                                    <div class="text-xs text-info">
                                        {% set policy = activeTicketOption.reschedulePolicy %}
                                        {% if policy == constant('App\\Entity\\TicketReschedulePolicy::ONETIME_24H_BEFORE') %}
                                            {{ 'ticket.reschedule.onetime_24h'|trans|raw }}
                                        {% elseif policy == constant('App\\Entity\\TicketReschedulePolicy::UNLIMITED_24H_BEFORE') %}
                                            {{ 'ticket.reschedule.unlimited_24h'|trans|raw }}
                                        {% else %}
                                            {{ 'ticket.reschedule.not_allowed'|trans|raw }}
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="text-lg font-bold">{{ this.quotedPrice ?? activeTicketOption.price }}</span>
                            </div>
                            <p class="text-sm text-muted-foreground mb-4">{{ ('lesson.' ~ activeTicketOption.type.value ~ '.description')|trans|raw|nl2br }}</p>

                            {% if paymentStatus == 'price_changed' %}
                                <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800 mb-4">
                                    {{ 'booking.price_changed'|trans }}
                                </div>
                            {% endif %}

                            <div class="mt-4 space-y-4">
                                {% if this.needsPhone %}
                                <div>
                                    <label class="text-sm font-medium leading-none block mb-1" for="booking-phone">{{ 'booking.phone.label'|trans }}</label>
                                    <input
                                        id="booking-phone"
                                        type="tel"
                                        data-model="phone"
                                        placeholder="{{ 'booking.phone.placeholder'|trans }}"
                                        class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"
                                        required
                                    >
                                    <p class="text-xs text-muted-foreground mt-1">{{ 'booking.phone.account_hint'|trans }}</p>
                                    {% if phoneError %}
                                        <p class="text-sm text-red-600 mt-1">{{ phoneError|trans }}</p>
                                    {% endif %}
                                </div>
                                {% endif %}
                                <div>
                                    <label class="text-sm font-medium leading-none block mb-1">{{ 'booking.child.optional'|trans }}</label>
                                    {% set children = this.getChildren %}
                                    {% if children is not empty %}
                                        <select data-model="selectedChildId" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm">
                                            {% for c in children %}
                                                <option value="{{ c.id }}" {% if selectedChildId == c.id or (selectedChildId is null and loop.first) %}selected{% endif %}>{{ c.name }}{% if c.birthday %} ({{ c.birthday }}){% endif %}</option>
                                            {% endfor %}
                                            <option value="">{{ 'booking.child.none'|trans }}</option>
                                        </select>
                                    {% else %}
                                        <div class="rounded-md border border-dashed border-workshop-yellow/60 bg-workshop-yellow/10 px-3 py-3 text-sm text-workshop-brown">
                                            <p class="font-medium mb-1">{{ 'booking.child.empty_title'|trans }}</p>
                                            <p class="text-muted-foreground mb-2">{{ 'booking.child.empty_hint'|trans }}</p>
                                            <a href="{{ path('profile') }}" class="text-workshop-red hover:underline font-medium">{{ 'booking.child.add_now'|trans }}</a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2 mt-4">
                    <div class="flex w-full flex-col space-y-2">
                        {% if isFeatureEnabled('cart') %}
                            {% if addedToCart %}
                                <div class="rounded-md border border-green-300 bg-green-50 px-3 py-2 text-sm text-green-800">
                                    {{ 'cart.added_to_cart'|trans }}
                                </div>
                            {% elseif addToCartError %}
                                <div class="rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
                                    {{ addToCartError|trans }}
                                </div>
                            {% endif %}
                        {% endif %}
                        <div class="flex gap-2">
                            {% if isFeatureEnabled('cart') %}
                                <button
                                        type="button"
                                        data-action="live#action"
                                        data-live-action-param="addToCart"
                                        {{ lesson.canBeBooked and lesson.future ? '' : 'disabled' }}
                                        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border hover:text-accent-foreground h-10 px-4 py-2 flex-1 bg-workshop-yellow/10 border-workshop-yellow text-workshop-brown hover:bg-workshop-yellow/20">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="w-4 h-4 mr-2">
                                        <circle cx="8" cy="21" r="1"></circle>
                                        <circle cx="19" cy="21" r="1"></circle>
                                        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                                    </svg>
                                    {{ 'booking.add_to_cart'|trans }}
                                </button>
                            {% endif %}

                            <button
                                    data-action="live#action"
                                    data-live-action-param="processPayment"
                                    {{ lesson.canBeBooked and lesson.future ? '' : 'disabled pointer-events-none' }}
                                    class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 px-4 py-2 flex-1 bg-workshop-red text-white hover:bg-workshop-red/90">
                                {{ 'booking.confirm_booking'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button"
                        data-action="click->modal-transition#close click->live#action"
                        data-live-action-param="closePaymentModal"
                        class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="h-4 w-4">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                    <span class="sr-only">{{ 'lesson.close'|trans }}</span>
                </button>
            </div>
            </div>
        {% endif %}
    {% endif %}
</div>
