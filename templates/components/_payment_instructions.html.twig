{#
  Shared BLIK / bank-transfer payment instructions.

  Params:
    - amount        Brick\Money\Money  amount still owed
    - payment_code  string             the 4-char transfer title / BLIK reference
    - awaiting      bool (optional)    show the "awaiting payment" hint
    - bookings      iterable<Booking> (optional)  render an "add to calendar" link per booked lesson

  Extracted from LessonModal / UpcomingAttendeesComponent so the customer panel
  (OutstandingPaymentsComponent, BillingComponent) renders the exact same block.
#}
{% set org = organization() %}
<div class="w-full rounded-xl border border-panel-line bg-panel-surface p-6 text-center">
    {% if awaiting|default(false) %}
        <p class="mb-3 text-xs text-panel-muted">{{ 'payment.awaiting'|trans }}</p>
    {% endif %}
    <p class="text-lg font-bold text-panel-ink">
        {{ 'blik.instruction'|trans }}
        <span class="whitespace-nowrap text-panel-accent">{{ org.blikPhone }}</span>
    </p>
    <p class="mt-1 text-sm text-panel-muted">
        {{ 'blik.instruction_2'|trans }}
        <span class="whitespace-nowrap font-semibold text-panel-ink">{{ amount|money }}</span>.
        {{ 'blik.instruction_3'|trans }}
    </p>
    <div class="my-4 select-all rounded-lg bg-panel-canvas px-4 py-3 font-mono text-2xl tracking-[0.3em] text-panel-accent-ink">{{ payment_code }}</div>
    <p class="text-xs text-panel-muted">{{ 'blik.info'|trans }}</p>
    <p class="mt-4 border-t border-panel-line pt-4 text-xs text-panel-muted">
        {{ 'blik.alt_transfer'|trans({
            'title': payment_code,
            'account': '<span class="whitespace-nowrap font-semibold text-panel-ink">' ~ org.bankAccount ~ '</span>',
        })|raw }}
    </p>
    {% if bookings|default([]) is not empty %}
        <div class="mt-4 flex flex-col items-center gap-2 border-t border-panel-line pt-4">
            {% for booking in bookings %}
                {% for lesson in booking.lessons %}
                    <a href="{{ lesson_google_calendar_url(lesson) }}" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-2 rounded-lg border border-panel-line px-4 py-2 text-sm font-semibold text-panel-ink transition-colors hover:bg-panel-canvas">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
                        {{ 'payment.add_to_calendar'|trans }} — {{ lesson.metadata.title }}
                    </a>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}
</div>
