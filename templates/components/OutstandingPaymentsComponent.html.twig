{% set payments = this.getPayments() %}
<div {{ attributes.defaults(
    awaitingPayment and paymentCode
        ? {'data-poll': 'delay(3000)|refreshPaymentStatus'}
        : {}
) }}>
    {% if awaitingPayment and paymentCode %}
        {% set watched = this.getWatchedPayment() %}
        <section class="rounded-xl border border-panel-accent/30 bg-panel-accent-soft/50 p-4 sm:p-6">
            <div class="mb-4 flex items-center justify-between">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-panel-accent-ink">{{ 'panel.billing.pay_title'|trans }}</p>
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="cancelPay"
                        class="text-xs font-semibold text-panel-muted transition-colors hover:text-panel-accent">
                    {{ 'panel.billing.pay_later'|trans }}
                </button>
            </div>
            <div class="mx-auto max-w-md">
                {{ include('components/_payment_instructions.html.twig', {
                    amount: watched ? watched.amount : null,
                    payment_code: paymentCode,
                    awaiting: true,
                }) }}
            </div>
        </section>
    {% elseif payments is not empty %}
        <section class="rounded-xl border border-panel-accent/30 bg-panel-accent-soft/50 p-4 sm:p-6">
            <div class="flex items-start gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-panel-accent"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                <div>
                    <h2 class="text-base font-bold text-panel-ink">{{ 'panel.billing.outstanding_title'|trans }}</h2>
                    <p class="text-sm text-panel-muted">{{ 'panel.billing.outstanding_lead'|trans }}</p>
                </div>
            </div>
            <ul class="mt-4 space-y-2.5">
                {% for payment in payments %}
                    <li class="flex flex-col gap-3 rounded-lg border border-panel-line bg-panel-surface p-4 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <p class="truncate font-medium text-panel-ink">
                                {{ payment.bookingsSummary ?: payment.description ?: 'panel.billing.payment_generic'|trans }}
                            </p>
                            <p class="text-xs text-panel-muted">
                                {{ 'panel.billing.issued_on'|trans({date: payment.createdAt|date('d.m.Y')}) }}
                                {% if payment.status == 'expired' %}
                                    · <span class="font-semibold text-panel-accent">{{ 'dashboard.payment.expired'|trans }}</span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <span class="whitespace-nowrap text-lg font-bold text-panel-ink">{{ payment.amount|money }}</span>
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="pay"
                                    data-live-payment-id-param="{{ payment.id }}"
                                    class="inline-flex items-center justify-center rounded-lg bg-panel-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-panel-accent/90">
                                {{ 'booking.pay'|trans }}
                            </button>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
</div>
