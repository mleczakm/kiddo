<div {{ attributes }}>
    <h2 class="sr-only">{{ 'profile.title'|trans }}</h2>
    <div class="rounded-xl border border-panel-line bg-panel-surface p-6">
        {% if not this.isEditing %}
            <div class="flex items-center justify-between gap-3">
                <h3 class="text-base font-bold text-panel-ink">{{ 'profile.section_heading'|trans }}</h3>
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="startEditing"
                        class="inline-flex items-center gap-2 rounded-lg border border-panel-line px-3 py-1.5 text-xs font-semibold text-panel-ink transition-colors hover:bg-panel-canvas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    {{ 'profile.edit_profile'|trans }}
                </button>
            </div>
            <dl class="mt-4 divide-y divide-panel-line text-sm">
                <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-3">
                    <dt class="text-panel-muted">{{ 'profile.name'|trans }}</dt>
                    <dd class="font-medium text-panel-ink sm:col-span-2">{{ this.user.name }}</dd>
                </div>
                <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-3">
                    <dt class="text-panel-muted">{{ 'profile.email'|trans }}</dt>
                    <dd class="font-medium text-panel-ink sm:col-span-2">{{ this.user.email }}</dd>
                </div>
                <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-3">
                    <dt class="text-panel-muted">{{ 'profile.phone'|trans }}</dt>
                    <dd class="font-medium text-panel-ink sm:col-span-2">{{ this.formattedPhone ?? ('profile.phone.empty'|trans) }}</dd>
                </div>
                <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-3">
                    <dt class="text-panel-muted">{{ 'profile.newsletter'|trans }}</dt>
                    <dd class="sm:col-span-2">
                        {% if this.user.newsletterSubscribed %}
                            <span class="font-medium text-emerald-600">{{ 'newsletter.subscribed'|trans }}</span>
                        {% else %}
                            <span class="font-medium text-panel-muted">{{ 'newsletter.not_subscribed'|trans }}</span>
                        {% endif %}
                    </dd>
                </div>
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-3">
                        <dt class="text-panel-muted">{{ 'profile.user_roles'|trans }}</dt>
                        <dd class="text-panel-ink sm:col-span-2">{{ this.user.roles|map(role => role|trans)|join(', ') }}</dd>
                    </div>
                {% endif %}
            </dl>
            <div class="mt-4 border-t border-panel-line pt-4">
                <a href="{{ path('app_logout') }}"
                   class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-panel-accent transition-colors hover:bg-panel-accent-soft">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                    {{ 'page.logout'|trans }}
                </a>
            </div>
        {% else %}
            <form data-action="live#action" data-live-action-param="save" class="space-y-4">
                <h3 class="text-base font-bold text-panel-ink">{{ 'profile.edit_profile'|trans }}</h3>
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-panel-ink" for="name">{{ 'profile.name'|trans }}</label>
                    <input type="text" data-model="name" id="name"
                           class="flex h-10 w-full rounded-lg border border-panel-line bg-panel-surface px-3 py-2 text-sm text-panel-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-panel-accent">
                    {% if this.getErrors('name') %}
                        <p class="text-sm text-panel-accent">{{ this.getErrors('name')|map(error => error|trans)|join(', ') }}</p>
                    {% endif %}
                </div>
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-panel-ink" for="email">{{ 'profile.email'|trans }}</label>
                    <input type="email" data-model="email" id="email"
                           class="flex h-10 w-full rounded-lg border border-panel-line bg-panel-surface px-3 py-2 text-sm text-panel-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-panel-accent">
                    {% if this.getErrors('email') %}
                        <p class="text-sm text-panel-accent">{{ this.getErrors('email')|map(error => error|trans)|join(', ') }}</p>
                    {% endif %}
                </div>
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-panel-ink" for="phone">{{ 'profile.phone'|trans }}</label>
                    <input type="tel" data-model="phone" id="phone" required placeholder="{{ 'profile.phone.placeholder'|trans }}"
                           class="flex h-10 w-full rounded-lg border border-panel-line bg-panel-surface px-3 py-2 text-sm text-panel-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-panel-accent">
                    {% if this.getErrors('phone') %}
                        <p class="text-sm text-panel-accent">{{ this.getErrors('phone')|map(error => error|trans)|join(', ') }}</p>
                    {% endif %}
                    {% if phoneError %}
                        <p class="text-sm text-panel-accent">{{ phoneError|trans }}</p>
                    {% endif %}
                </div>
                <label class="flex items-center gap-2 text-sm font-medium text-panel-ink">
                    <input type="checkbox" data-model="newsletterSubscribed"
                           class="h-4 w-4 rounded border-panel-line text-panel-accent focus:ring-panel-accent">
                    {{ 'profile.newsletter'|trans }}
                </label>
                <div class="flex gap-3 border-t border-panel-line pt-4">
                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-lg bg-panel-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-panel-accent/90">
                        {{ 'profile.save_changes'|trans }}
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="cancelEditing"
                            class="inline-flex items-center justify-center rounded-lg border border-panel-line px-4 py-2 text-sm font-semibold text-panel-ink transition-colors hover:bg-panel-canvas">
                        {{ 'profile.cancel'|trans }}
                    </button>
                </div>
            </form>
        {% endif %}
    </div>
</div>
