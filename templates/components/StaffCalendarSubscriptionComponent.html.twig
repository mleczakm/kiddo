<div {{ attributes }} data-controller="clipboard">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-3 mb-4">
            <h3 class="flex items-center gap-3 text-base font-black text-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
                <span>{{ 'calendar_feed.title'|trans({}, 'admin') }}</span>
                {{ include('admin/help/_context_button.html.twig', {slug: 'kalendarz-personelu', label: 'Subskrypcja kalendarza personelu'}) }}
            </h3>
            {% if this.token %}
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="regenerate"
                        data-loading="attr(disabled)"
                        class="text-xs font-semibold text-slate-400 hover:text-red-600 transition"
                        onclick="return confirm('{{ 'calendar_feed.reset_confirm'|trans({}, 'admin')|e('js') }}')">
                    {{ 'calendar_feed.reset'|trans({}, 'admin') }}
                </button>
            {% endif %}
        </div>

        <p class="text-sm text-slate-500 mb-4">{{ 'calendar_feed.intro'|trans({}, 'admin') }}</p>

        {% if not this.token %}
            <button type="button"
                    data-action="live#action"
                    data-live-action-param="regenerate"
                    data-loading="attr(disabled)"
                    class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 transition">
                {{ 'calendar_feed.generate'|trans({}, 'admin') }}
            </button>
        {% else %}
            <div class="space-y-4">
                {% for key, feed in this.feeds %}
                    <div class="rounded-2xl border border-slate-100 bg-slate-50/60 p-4">
                        <div class="text-sm font-bold text-slate-700 mb-2">
                            {{ ('calendar_feed.scope_' ~ key)|trans({}, 'admin') }}
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <input type="text" readonly value="{{ feed.webcal }}"
                                   data-clipboard-target="source"
                                   class="min-w-0 flex-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-600 font-mono"
                                   onfocus="this.select()">
                            <button type="button"
                                    data-action="clipboard#copy"
                                    data-clipboard-value="{{ feed.webcal }}"
                                    class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                                {{ 'calendar_feed.copy'|trans({}, 'admin') }}
                            </button>
                            <a href="{{ feed.google }}" target="_blank" rel="noopener"
                               class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700 transition">
                                {{ 'calendar_feed.add_google'|trans({}, 'admin') }}
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <p class="mt-3 text-xs text-slate-400">{{ 'calendar_feed.refresh_note'|trans({}, 'admin') }}</p>
        {% endif %}
    </div>
</div>
