<div {{ attributes }}>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
        <div class="p-6 border-b border-slate-100 bg-slate-50 shrink-0 flex flex-col space-y-1.5">
            <h3 class="flex items-center gap-3 text-lg font-black text-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-wallet w-5 h-5 text-indigo-600">
                    <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/>
                    <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
                </svg>
                <span>{{ 'payment.pending_transfers'|trans }}</span>
            </h3>
        </div>
        <div class="p-6 pt-0">
            {# Desktop table (md and up) #}
            <div class="hidden md:block relative w-full overflow-auto">
                <table class="w-full caption-bottom text-sm">
                    <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-slate-50">
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                            {{ 'payment.sender'|trans }}
                        </th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                            {{ 'payment.title'|trans }}
                        </th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                            {{ 'payment.amount'|trans }}
                        </th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                            {{ 'payment.date'|trans }}
                        </th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">
                            {{ 'admin_dashboard.bookings.table.headers.actions'|trans }}
                        </th>
                    </tr>
                    </thead>
                    <tbody class="[&_tr:last-child]:border-0">
                    {% for transfer in this.transfers %}
                        <tr class="border-b transition-colors hover:bg-slate-50">
                            <td class="p-4 align-middle">
                                <div class="font-medium text-slate-800">{{ transfer.sender }}</div>
                            </td>
                            <td class="p-4 align-middle text-slate-600 max-w-xs truncate" title="{{ transfer.title }}">
                                {{ transfer.title }}
                            </td>
                            <td class="p-4 align-middle font-bold text-slate-800">
                                {{ transfer.amount }} zł
                            </td>
                            <td class="p-4 align-middle text-slate-600">
                                {{ transfer.transferredAt|date('Y-m-d H:i') }}
                            </td>
                            <td class="p-4 align-middle text-right">
                                <button
                                    data-action="live#action"
                                    data-live-action-param="reject"
                                    data-live-transfer-id-param="{{ transfer.id }}"
                                    class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-xs font-bold transition border border-red-200 bg-white hover:bg-red-50 text-red-600 h-9 rounded-lg px-3"
                                >
                                    {{ 'payment.reject'|trans }}
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="p-8 text-center text-slate-400 font-medium">{{ 'payment.no_transfers'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Mobile cards (below md) #}
            <div class="md:hidden space-y-3">
                {% for transfer in this.transfers %}
                    <div class="border border-slate-200 rounded-xl p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="font-medium text-slate-800 truncate">{{ transfer.sender }}</div>
                                <div class="text-xs text-slate-500 truncate" title="{{ transfer.title }}">{{ transfer.title }}</div>
                            </div>
                            <span class="shrink-0 font-bold text-slate-800">{{ transfer.amount }} zł</span>
                        </div>
                        <div class="flex items-center justify-between mt-3">
                            <span class="text-xs text-slate-500">{{ transfer.transferredAt|date('Y-m-d H:i') }}</span>
                            <button
                                data-action="live#action"
                                data-live-action-param="reject"
                                data-live-transfer-id-param="{{ transfer.id }}"
                                class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-xs font-bold transition border border-red-200 bg-white hover:bg-red-50 text-red-600 h-9 rounded-lg px-3"
                            >
                                {{ 'payment.reject'|trans }}
                            </button>
                        </div>
                    </div>
                {% else %}
                    <p class="p-8 text-center text-slate-400 font-medium">{{ 'payment.no_transfers'|trans }}</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
