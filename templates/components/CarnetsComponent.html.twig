<div {{ attributes }} class="space-y-6">
    {% set subscriptions = this.getSubscriptions() %}
    {% if subscriptions is not empty %}
        <section>
            <h2 class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-panel-muted">{{ 'panel.carnets.subscriptions'|trans }}</h2>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                {% for sub in subscriptions %}
                    <div class="rounded-xl border border-panel-line bg-panel-surface p-5 border-l-4 border-l-emerald-500">
                        <div class="flex items-start justify-between gap-3">
                            <h3 class="font-semibold text-panel-ink">{{ sub.series.lessons|length ? sub.series.lessons|first.metadata.title : '—' }}</h3>
                            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-800">{{ ('panel.subscription.status.' ~ sub.status)|trans }}</span>
                        </div>
                        <dl class="mt-3 space-y-1.5 text-sm">
                            <div class="flex justify-between">
                                <dt class="text-panel-muted">{{ 'panel.carnets.monthly_rate'|trans }}</dt>
                                <dd class="font-medium text-panel-ink">{{ (sub.monthlyRateMinor / 100)|number_format(2, ',', ' ') }} zł</dd>
                            </div>
                            {% if sub.child %}
                                <div class="flex justify-between">
                                    <dt class="text-panel-muted">{{ 'booking.child.label'|trans }}</dt>
                                    <dd class="font-medium text-panel-ink">{{ sub.child.name }}</dd>
                                </div>
                            {% endif %}
                            {% if sub.lastChargedPeriod %}
                                <div class="flex justify-between">
                                    <dt class="text-panel-muted">{{ 'panel.carnets.last_charged'|trans }}</dt>
                                    <dd class="font-medium text-panel-ink">{{ sub.lastChargedPeriod }}</dd>
                                </div>
                            {% endif %}
                        </dl>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% set carnets = this.getCarnets() %}
    {% if carnets is not empty %}
        <section>
            <h2 class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-panel-muted">{{ 'page.my_carnets'|trans }}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% for booking in carnets %}
                    <div class="rounded-lg border bg-card text-card-foreground shadow-sm border-l-4 border-l-workshop-green">
                        <div class="p-6">
                            <div class="flex justify-between items-start mb-3">
                                <h3 class="font-bold text-lg">{{ booking.title }}</h3>
                                <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground {{ booking.status == 'active' ? 'bg-green-50' : 'bg-blue-50' }} border-green-200">
                                    {{ ('dashboard.status.' ~ booking.status)|trans }}
                                </div>
                            </div>
                            <div class="space-y-2 text-sm mb-4">
                                <div class="flex justify-between">
                                    <span class="text-muted-foreground">{{ 'dashboard.sessions_used'|trans }}:</span>
                                    <span>{{ booking.lessonsMap.past.count() }} z {{ booking.lessonsMap.active.count() + booking.lessonsMap.past.count() }}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-muted-foreground">{{ 'dashboard.valid_until'|trans }}:</span>
                                    {% set latestDate = null %}
                                    {% for lesson in booking.lessons %}
                                        {% if latestDate is null or lesson.schedule > latestDate %}
                                            {% set latestDate = lesson.schedule %}
                                        {% endif %}
                                    {% endfor %}
                                    <span>{{ latestDate ? latestDate|date('d.m.Y') : 'N/A' }}</span>
                                </div>
                            </div>
                            <div class="bg-muted rounded-lg h-2 mb-1">
                                {% set progress = (booking.lessonsMap.lessons.count() > 0) ? (booking.lessonsMap.active.count()) / (booking.lessonsMap.past.count() + booking.lessonsMap.active.count()) * 100 : 0 %}
                                <div class="h-2 rounded-lg bg-workshop-green"
                                     style="width: {{ progress }}%;"></div>
                            </div>
                            <p class="text-xs text-right text-muted-foreground">
                                {{ 'dashboard.sessions_remaining'|trans({
                                    'count': booking.lessonsMap.active.count(),
                                    '%count%': booking.lessonsMap.active.count()
                                }) }}
                            </p>

                            <div class="mt-4 pt-4 border-t">
                                <h4 class="text-sm font-medium mb-2">{{ 'dashboard.upcoming_sessions'|trans }}:</h4>
                                <ul class="space-y-2 text-sm">
                                    {% set upcomingSessions = [] %}
                                    {% for lesson in booking.lessons|filter(l => l.schedule > now())|sort((a, b) => a.schedule <=> b.schedule) %}
                                        {% set upcomingSessions = upcomingSessions|merge([{
                                            'lesson': lesson,
                                            'booking': booking
                                        }]) %}
                                    {% endfor %}

                                    {% for session in upcomingSessions %}
                                        {% set cancelled_item = booking.lessonsMap.cancelled.get(session.lesson.id, null) %}
                                        {% set isCancelled = cancelled_item is not null %}
                                        {% set isRescheduled = isCancelled and cancelled_item is instanceof('App\\Entity\\DTO\\RescheduledLesson') %}
                                        <li class="flex items-center {{ isCancelled ? 'text-muted-foreground' : '' }}">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                 viewBox="0 0 24 24" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 class="lucide lucide-calendar-days mr-2 text-workshop-red">
                                                <rect width="18" height="18" x="3" y="4" rx="2"
                                                      ry="2"></rect>
                                                <line x1="16" x2="16" y1="2" y2="6"></line>
                                                <line x1="8" x2="8" y1="2" y2="6"></line>
                                                <line x1="3" x2="21" y1="10" y2="10"></line>
                                                <path d="M8 14h.01"></path>
                                                <path d="M12 14h.01"></path>
                                                <path d="M16 14h.01"></path>
                                                <path d="M8 18h.01"></path>
                                                <path d="M12 18h.01"></path>
                                                <path d="M16 18h.01"></path>
                                            </svg>
                                            <span class="{{ isCancelled ? 'line-through' : '' }}">
                                                {{ session.lesson.schedule|date('d.m.Y H:i:s')|format_datetime(pattern: 'd MMMM') }} {{ 'dashboard.at'|trans }} {{ session.lesson.schedule|date('H:i') }}
                                            </span>
                                            {% if isCancelled %}
                                                <span class="ml-2 inline-flex items-center rounded-full bg-red-50 text-red-700 px-2.5 py-0.5 text-xs font-semibold border border-red-200">
                                                    {{ isRescheduled ? 'booking.rescheduled'|trans : 'booking.cancelled'|trans }}
                                                </span>
                                            {% endif %}
                                        </li>
                                    {% else %}
                                        <li class="text-muted-foreground">{{ 'dashboard.no_upcoming_sessions'|trans }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
</div>
