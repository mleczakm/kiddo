<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'Quicksand', Arial, sans-serif;
            line-height: 1.6;
            color: #583818;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        .email-container {
            background-color: #f9f1de;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header img {
            width: 220px;
            max-width: 100%;
            height: auto;
        }

        h1 {
            color: #583818;
            margin-top: 0;
        }

        .button {
            display: inline-block;
            background-color: #e85030;
            color: white;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            margin: 25px 0;
        }

        .button:hover {
            background-color: #cc3f22;
        }

        .note {
            background-color: rgba(248, 192, 40, 0.1);
            padding: 15px;
            border-left: 4px solid #f8c028;
            margin: 20px 0;
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 14px;
            color: #738f3e;
        }

        .help-text {
            font-size: 14px;
            color: #666;
            overflow-wrap: break-word;
        }
    </style>
</head>
<body>
<div class="email-container">
    <div class="header">
        {# Absolute URL is hardcoded: this template also renders from Messenger workers
           (daily reminders, payment notifications) with no HTTP request in scope, so
           absolute_url() has no host to resolve against. #}
        <img src="https://warsztatowniasensoryczna.pl{{ asset('images/logo-header.webp') }}" alt="Warsztatownia Sensoryczna">
    </div>
    {{ content|trans({}, 'email') }}
    <div class="footer">
        {{ 'footer'|trans({}, 'email') }}
    </div>
</div>
</body>
</html>