{% trans_default_domain 'emails' %}

<div style="background-color: white; border: 1px solid #e5e7eb; border-radius: 0.5rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); padding: 2rem; max-width: 32rem; text-align: center;">
    <div style="font-size: 1.25rem; font-weight: 700; color: #583818; margin-bottom: 0.75rem;">
        {{ 'waitlist_offer.heading'|trans }}
    </div>
    <div style="color: #374151; font-size: 0.95rem; margin-bottom: 0.75rem;">
        {{ 'waitlist_offer.body'|trans({name: name, lessonTitle: lessonTitle, lessonDate: lessonDate}) }}
    </div>
    <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 1.25rem;">
        {{ 'waitlist_offer.deadline'|trans({holdMinutes: holdMinutes, offerExpiresAt: offerExpiresAt}) }}
    </div>
    <a href="{{ url }}" style="display: inline-block; background-color: #e85030; color: white; font-weight: 600; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 0.5rem;">
        {{ 'waitlist_offer.cta'|trans }}
    </a>
    <div style="color: #6b7280; font-size: 0.8rem; margin-top: 1.25rem; word-break: break-all;">
        {{ url }}
    </div>
</div>
