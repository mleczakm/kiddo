{% trans_default_domain 'emails' %}

<style>
    .report-wrapper {
        font-family: Arial, sans-serif;
        color: #4c2e11;
    }
    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #4c2e11;
        margin: 28px 0 12px;
        padding-bottom: 6px;
        border-bottom: 2px solid #f7c343;
    }
    .stats-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 8px 0;
        margin-bottom: 8px;
    }
    .stat-card {
        background-color: #f9f1de;
        border-radius: 10px;
        padding: 14px;
        text-align: center;
        vertical-align: top;
        width: 33%;
    }
    .stat-card .stat-value {
        font-size: 22px;
        font-weight: 800;
        color: #e34646;
    }
    .stat-card .stat-label {
        font-size: 12px;
        color: #738f3e;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .detail-list {
        margin: 10px 2px 0;
        padding: 0;
        list-style: none;
        font-size: 13px;
    }
    .detail-list li {
        padding: 6px 0;
        border-bottom: 1px solid #eee2c8;
    }
    .detail-list li:last-child {
        border-bottom: none;
    }
    .empty-note {
        color: #999;
        font-style: italic;
        font-size: 13px;
        margin: 8px 0 0;
    }
</style>

<div class="report-wrapper">
    <div class="section-title">{{ 'daily_lessons_schedule.yesterday.heading'|trans({'date': yesterday|format_datetime(pattern='EEEE, dd.MM')}) }}</div>

    <table class="stats-table" role="presentation">
        <tr>
            <td class="stat-card">
                <div class="stat-value">{{ newUsers|length }}</div>
                <div class="stat-label">{{ 'daily_lessons_schedule.yesterday.new_users.title'|trans }}</div>
            </td>
            <td class="stat-card">
                <div class="stat-value">{{ newBookings|length }}</div>
                <div class="stat-label">{{ 'daily_lessons_schedule.yesterday.new_reservations.title'|trans }}</div>
            </td>
            <td class="stat-card">
                <div class="stat-value">{{ revenue|money }}</div>
                <div class="stat-label">{{ 'daily_lessons_schedule.yesterday.revenue.title'|trans }}</div>
            </td>
        </tr>
    </table>

    {% if newUsers is not empty %}
        <ul class="detail-list">
            {% for newUser in newUsers %}
                <li>👤 <strong>{{ newUser.name }}</strong> — {{ newUser.email }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty-note">{{ 'daily_lessons_schedule.yesterday.new_users.none'|trans }}</p>
    {% endif %}

    {% if newBookings is not empty %}
        <ul class="detail-list">
            {% for newBooking in newBookings %}
                <li>🎫 <strong>{{ newBooking.user.name }}</strong>{% if newBooking.child %} ({{ newBooking.child.name }}){% endif %} — {{ newBooking.lessons|map(l => l.metadata.title)|join(', ') }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty-note">{{ 'daily_lessons_schedule.yesterday.new_reservations.none'|trans }}</p>
    {% endif %}

    <div class="section-title">{{ 'daily_lessons_schedule.today.heading'|trans({'date': date|format_datetime(pattern='EEEE, dd.MM')}) }}</div>

    {% if lessons is empty %}
        <p class="empty-note">{{ 'daily_lessons_schedule.no_lessons'|trans({'date': date|format_datetime(pattern='EEEE, dd.MM')}) }}</p>
    {% endif %}

    {% include 'email/notification/_lesson_schedule_cards.html.twig' with {'lessons': lessons} %}
</div>
