{% trans_default_domain 'emails' %}
<p>{{ 'payment.notification.user.info'|trans({'amount': payment.amount|money, 'date': payment.createdAt|format_datetime(pattern='EEEE HH:mm')}) }}</p>

<ul>
    {% for lesson in lessons %}
        {% set booking = bookings|filter(b => b.lessons.contains(lesson))|first %}
        {% set calendarLink = calendarLinks[loop.index0] ?? null %}
        <li>
            <strong>{{ lesson.metadata.title }}</strong>
            ({{ lesson.schedule|format_datetime(pattern='EEEE, HH:mm, dd MMM') }})
            {% if booking and booking.child %}
                - {{ booking.child.name }}{% if booking.child.ageYears %} ({{ 'profile.children.years'|trans({count: booking.child.ageYears}, 'messages') }}){% endif %}
            {% endif %}
            {% if calendarLink %}
                <br>
                <a href="{{ calendarLink }}" style="display:inline-block; margin-top:4px; color:#e85030; font-weight:600; text-decoration:none;">
                    {{ 'payment.notification.user.add_to_calendar'|trans }}
                </a>
            {% endif %}
        </li>
    {% endfor %}
</ul>

<p style="color:#6b7280; font-size:0.875rem;">{{ 'payment.notification.user.calendar_hint'|trans }}</p>

<p>{{ 'payment.notification.user.footer'|trans }}</p>
