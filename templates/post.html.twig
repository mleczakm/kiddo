{% extends 'base_public_content.html.twig' %}

{% block title %}{{ post.seo.seoTitle|default(post.body.title) }} | Kiddo{% endblock %}

{% block meta %}
    {% set metaDescription = post.seo.seoDescription|default(post.body.excerpt) %}
    {% if metaDescription %}<meta name="description" content="{{ metaDescription }}">{% endif %}
    {% if preview|default(false) or not post.seo.shouldRobotsIndex or not post.seo.shouldRobotsFollow %}
        <meta name="robots" content="noindex,nofollow">
    {% else %}
        <meta name="robots" content="index,follow">
    {% endif %}
    {% if post.seo.canonicalUrl %}
        <link rel="canonical" href="{{ post.seo.canonicalUrl }}">
    {% elseif not preview|default(false) %}
        <link rel="canonical" href="{{ url('post_by_slug', {slug: post.slug}) }}">
    {% endif %}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ post.seo.socialTitle|default(post.seo.seoTitle)|default(post.body.title) }}">
    {% if post.seo.socialDescription|default(metaDescription) %}<meta property="og:description" content="{{ post.seo.socialDescription|default(metaDescription) }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">

    {% if not preview|default(false) and post.seo.shouldRobotsIndex %}
        {% set cover = post.coverAttachment %}
        {% set jsonLd = {
            '@context': 'https://schema.org',
            '@type': 'Article',
            headline: post.body.title,
            description: metaDescription,
            datePublished: post.publishedAt|date('c'),
            dateModified: post.updatedAt|date('c'),
            author: { '@type': 'Person', name: post.author.name },
            mainEntityOfPage: { '@type': 'WebPage', '@id': post.seo.canonicalUrl|default(url('post_by_slug', {slug: post.slug})) },
        } %}
        {% if cover %}
            {% set jsonLd = jsonLd|merge({ image: [url('stored_file', {id: cover.file.id, safeName: cover.file.originalName})] }) %}
        {% endif %}
        <script type="application/ld+json">{{ jsonLd|json_encode|raw }}</script>
    {% endif %}
{% endblock %}

{% block body %}
    <main class="px-5 py-14 md:py-20">
        <article class="mx-auto max-w-5xl">
            <a href="{{ path('homepage') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-500 transition-colors hover:text-workshop-red">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                powrót do Warsztatowni
            </a>

            {% if preview|default(false) %}
                <div class="mb-8 mt-8 rounded-xl bg-amber-100 px-4 py-3 text-sm font-bold text-amber-900">Podgląd ostatnio zapisanej wersji roboczej</div>
            {% endif %}

            {% if post.body.eyebrow %}
                <p class="mt-8 text-xs font-black uppercase tracking-[0.2em] text-workshop-red">{{ post.body.eyebrow }}</p>
            {% endif %}

            <h1 class="{{ post.body.eyebrow ? 'mt-4' : 'mt-8' }} max-w-4xl text-4xl leading-tight text-workshop-brown md:text-6xl">{{ post.body.title }}</h1>

            {% if post.body.excerpt %}
                <p class="mt-6 max-w-3xl text-xl leading-relaxed text-stone-700">{{ post.body.excerpt }}</p>
            {% endif %}

            <div class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold text-stone-600">
                <span>{{ post.author.name }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ (post.publishedAt|default(post.updatedAt))|format_datetime('medium', 'none', locale: 'pl') }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ post.body.contentHtml|reading_time }} min czytania</span>
            </div>

            {% set cover = post.coverAttachment %}
            {% if cover %}
                <figure class="mt-10">
                    <img src="{{ path('stored_file', {id: cover.file.id, safeName: cover.file.originalName}) }}"
                         alt="{{ cover.altText|default('') }}"
                         class="w-full rounded-2xl object-cover"
                         style="aspect-ratio: 16 / 9;"
                         width="1600" height="900">
                    {% if cover.caption %}
                        <figcaption class="mt-2 text-center text-sm text-stone-500">{{ cover.caption }}</figcaption>
                    {% endif %}
                </figure>
            {% endif %}

            <div class="article-content prose prose-lg mx-auto mt-14 max-w-3xl">{{ post.body.contentHtml|raw }}</div>

            {% set downloads = post.files|filter(f => f.role.value == 'attachment')|map(a => {
                name: a.downloadName|default(a.file.originalName),
                description: a.caption,
                url: path('stored_file', {id: a.file.id, safeName: a.downloadName|default(a.file.originalName)}),
                meta: (a.file.originalName|split('.')|last|upper) ~ ' · ' ~ (a.file.size|format_bytes),
            }) %}
            {% include 'partials/attachment-downloads.html.twig' with { title: 'Do pobrania', downloads: downloads } only %}

            <div class="article-cta">
                <div class="article-cta__inner">
                    <h2 class="article-cta__title">Chcesz dołączyć do najbliższych zajęć?</h2>
                    <p class="article-cta__desc">Przeglądaj nasze warsztaty i zarezerwuj miejsce dla swojego dziecka.</p>
                    <a href="{{ path('workshops') }}" class="article-cta__button">Zobacz warsztaty</a>
                </div>
            </div>
        </article>
    </main>
{% endblock %}
