{% set main_nav_extra_links = menu_hook_links('main_nav_extra') %}
{% set main_nav_before_auth_links = menu_hook_links('main_nav_before_auth') %}
{% set org = organization() %}
<header class="bg-white shadow-sm sticky top-0 z-50" data-controller="mobile-menu">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center h-16">
            <a class="flex items-center shrink-0" href="{{ path('homepage') }}"
               title="{{ 'last_update'|trans }}{{ last_release()|format_date(pattern: 'HH:mm, dd MMM') }}">
                <img src="{{ asset('images/logo-header.webp') }}" alt="Warsztatownia Sensoryczna" class="h-10 md:h-12 w-auto">
            </a>

            <nav class="hidden md:flex items-center gap-8 ml-8">
                <a class="text-sm font-medium text-workshop-brown hover:text-workshop-red transition-colors"
                   href="{{ path('homepage') }}">{{ 'page.homepage'|trans }}</a>
                <a class="text-sm font-medium text-workshop-brown hover:text-workshop-red transition-colors"
                   href="{{ path('workshops') }}">{{ 'page.workshops'|trans }}</a>
                {% if app.user %}
                    <a class="text-sm font-medium text-workshop-brown hover:text-workshop-red transition-colors"
                       href="{{ path('dashboard') }}">{{ 'page.my_bookings'|trans }}</a>
                {% endif %}
                {% for link in main_nav_extra_links %}
                    <a class="text-sm font-medium text-workshop-brown hover:text-workshop-red transition-colors"
                       href="{{ link.url }}">{{ link.label }}</a>
                {% endfor %}
                {% if org.facebookUrl %}
                    <a class="text-workshop-brown hover:text-workshop-red transition-colors"
                       href="{{ org.facebookUrl }}" target="_blank" rel="noopener me"
                       title="{{ 'page.facebook_cta'|trans }}" aria-label="Facebook">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.99 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.99 22 12z"/>
                        </svg>
                    </a>
                {% endif %}
            </nav>

            <div class="hidden md:flex items-center gap-4 ml-auto">
                {% if app.user %}
                    {% if isFeatureEnabled('cart') %}
                        <div class="relative">
                            {{ component('CartComponent') }}
                        </div>
                    {% endif %}
                    <div class="relative">
                        {{ component('NotificationTrayLiveComponent') }}
                    </div>
                {% else %}
                    {% for link in main_nav_before_auth_links %}
                        <a class="text-sm font-medium text-workshop-brown hover:text-workshop-red transition-colors"
                           href="{{ link.url }}">{{ link.label }}</a>
                    {% endfor %}
                    <a href="{{ path('app_login') }}"
                       class="font-medium text-sm text-workshop-brown hover:text-workshop-red transition-colors">{{ 'page.login'|trans }}</a>
                    <a href="{{ path('user_register') }}"
                       class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-4 py-2 bg-workshop-red text-white hover:bg-workshop-red/90">
                        {{ 'page.register'|trans }}
                    </a>
                {% endif %}
            </div>

            <div class="flex md:hidden items-center gap-3 ml-auto">
                {% if app.user %}
                    {% if isFeatureEnabled('cart') %}
                        <div class="relative">
                            {{ component('CartComponent') }}
                        </div>
                    {% endif %}
                    <div class="relative">
                        {{ component('NotificationTrayLiveComponent') }}
                    </div>
                {% endif %}
                <button class="p-1.5 text-workshop-brown hover:bg-beige rounded-lg transition-colors"
                        data-action="mobile-menu#toggle"
                        aria-label="{{ 'page.menu.toggle'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-menu">
                        <line x1="4" x2="20" y1="12" y2="12"></line>
                        <line x1="4" x2="20" y1="6" y2="6"></line>
                        <line x1="4" x2="20" y1="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    {# Mobile drawer backdrop #}
    <div class="hidden fixed inset-0 bg-black/40 z-40 md:hidden"
         data-mobile-menu-target="backdrop"
         data-action="click->mobile-menu#close"
         aria-hidden="true"></div>

    {# Mobile drawer #}
    <nav class="mobile-menu fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-white shadow-xl z-50 md:hidden flex flex-col p-6 gap-1"
         data-mobile-menu-target="panel"
         aria-label="{{ 'page.menu.toggle'|trans }}">
        <div class="flex justify-between items-center mb-6">
            <img src="{{ asset('images/logo-header.webp') }}" alt="Warsztatownia Sensoryczna" class="h-8 w-auto">
            <button class="p-1.5 text-workshop-brown hover:bg-beige rounded-lg transition-colors"
                    data-action="mobile-menu#close"
                    aria-label="{{ 'page.menu.close'|trans }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <a href="{{ path('homepage') }}" class="font-medium text-workshop-brown hover:text-workshop-red transition-colors py-3 border-b border-beige">{{ 'page.homepage'|trans }}</a>
        <a href="{{ path('workshops') }}" class="font-medium text-workshop-brown hover:text-workshop-red transition-colors py-3 border-b border-beige">{{ 'page.workshops'|trans }}</a>
        {% if app.user %}
            <a href="{{ path('dashboard') }}" class="font-medium text-workshop-brown hover:text-workshop-red transition-colors py-3 border-b border-beige">{{ 'page.my_bookings'|trans }}</a>
            {% for link in main_nav_extra_links %}
                <a href="{{ link.url }}" class="font-medium text-workshop-brown hover:text-workshop-red transition-colors py-3 border-b border-beige">{{ link.label }}</a>
            {% endfor %}
        {% else %}
            {% for link in main_nav_before_auth_links %}
                <a href="{{ link.url }}" class="font-medium text-workshop-brown hover:text-workshop-red transition-colors py-3 border-b border-beige">{{ link.label }}</a>
            {% endfor %}
            <a href="{{ path('app_login') }}" class="font-medium text-workshop-brown hover:text-workshop-red transition-colors py-3 border-b border-beige">{{ 'page.login'|trans }}</a>
            <a href="{{ path('user_register') }}" class="mt-4 inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 py-2 bg-workshop-red text-white hover:bg-workshop-red/90 transition-colors">
                {{ 'page.register'|trans }}
            </a>
        {% endif %}
        {% if org.facebookUrl %}
            <a href="{{ org.facebookUrl }}" target="_blank" rel="noopener me"
               class="mt-4 inline-flex items-center gap-2 font-medium text-workshop-brown hover:text-workshop-red transition-colors"
               aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.99 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.99 22 12z"/>
                </svg>
                <span>{{ 'page.facebook_news'|trans }}</span>
            </a>
        {% endif %}
    </nav>
</header>
