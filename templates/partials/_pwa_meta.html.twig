{# Installable-app metadata. Android/Chrome read the manifest; iOS (16.4+) only
   delivers Web Push to a site added to the Home Screen, and needs the apple-*
   tags to launch it standalone. #}
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#fdc42f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Kiddo">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
