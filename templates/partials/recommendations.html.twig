{% if recommendations|length > 0 %}
    <section class="py-16" aria-labelledby="recommendations-title" aria-roledescription="{{ 'homepage.testimonials.carousel'|trans }}" data-controller="recommendations">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 id="recommendations-title" class="section-title">{{ 'homepage.testimonials.title'|trans }}</h2>
                <p class="text-lg text-muted-foreground max-w-2xl mx-auto">{{ 'homepage.testimonials.subtitle'|trans }}</p>
            </div>
            {% set colors = ['bg-workshop-blue/10 border-workshop-blue/30', 'bg-workshop-pink/10 border-workshop-pink/30', 'bg-workshop-yellow/10 border-workshop-yellow/30'] %}
        </div>
        <div class="recommendations-viewport" data-recommendations-target="viewport" tabindex="0" role="group" aria-label="{{ 'homepage.testimonials.carousel'|trans }}">
            <div class="recommendations-track" data-recommendations-target="track">
                {% for review in recommendations %}
                    <div class="recommendations-card {{ colors[loop.index0 % 3] }} p-6 rounded-2xl border shadow-sm" data-recommendations-target="slide" role="group" aria-label="{{ 'homepage.testimonials.slide'|trans({number: loop.index, total: recommendations|length}) }}">
                        <blockquote class="mb-6 text-lg italic">
                            {% if review.text|length > 250 %}
                                <details class="group">
                                    <summary class="cursor-pointer list-none">
                                        <span class="group-open:hidden whitespace-pre-line">{{ review.text|slice(0, 250) }}…</span>
                                        <span class="mt-3 block text-sm not-italic text-muted-foreground underline underline-offset-4">
                                            <span class="group-open:hidden">{{ 'homepage.testimonials.read_more'|trans }}</span>
                                            <span class="hidden group-open:inline">{{ 'homepage.testimonials.read_less'|trans }}</span>
                                        </span>
                                    </summary>
                                    <p class="mt-3 whitespace-pre-line">{{ review.text }}</p>
                                </details>
                            {% else %}
                                <p class="whitespace-pre-line">{{ review.text }}</p>
                            {% endif %}
                        </blockquote>
                        <div>
                            <p class="font-bold">{{ review.author }}</p>
                            <p class="text-sm text-muted-foreground">{{ review.source == 'google' ? 'Google' : 'Facebook' }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
