<footer class="bg-white py-8 border-t border-muted">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
            <div><img src="{{ asset('images/logo-full.webp') }}" alt="Warsztatownia Sensoryczna" class="h-20 w-auto mb-4">
                <p class="text-muted-foreground mb-4">{{ 'page.description'|trans }}</p></div>
            <div><h4 class="font-bold mb-4 text-workshop-brown">{{ 'page.quick_links'|trans }}</h4>
                <ul class="space-y-2">
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('homepage') }}">{{ 'page.homepage'|trans }}</a></li>
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('workshops') }}">{{ 'page.workshops'|trans }}</a></li>
                    {% if app.user %}
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ path('dashboard') }}">{{ 'page.my_bookings'|trans }}</a></li>
                    {% else %}
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ path('app_login') }}">{{ 'page.login'|trans }}</a></li>
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ path('user_register') }}">{{ 'page.register'|trans }}</a></li>
                    {% endif %}
                    {% for link in menu_hook_links('footer_links') %}
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ link.url }}">{{ link.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div><h4 class="font-bold mb-4 text-workshop-brown">Dokumenty</h4>
                <ul class="space-y-2">
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('legal_app_terms') }}">Regulamin aplikacji</a></li>
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('legal_classes_terms') }}">Regulamin zajęć</a></li>
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('legal_privacy') }}">Polityka prywatności</a></li>
                </ul>
            </div>
            <div><h4 class="font-bold mb-4 text-workshop-brown">{{ 'page.contact_us'|trans }}</h4>
                <address class="not-italic text-muted-foreground"><p>{{ 'page.default.address.street'|trans }}</p>
                    <p>Radzymin</p>
                    <p class="mt-2">{{ 'page.email'|trans }} {{ 'page.default.email'|trans }}</p>
                    <p>{{ 'page.phone'|trans }} +48 571 531 213</p></address>
                {% set org = organization() %}
                {% if org.facebookUrl %}
                    <div class="mt-6">
                        <h4 class="font-bold mb-2 text-workshop-brown">{{ 'page.follow_us'|trans }}</h4>
                        <a href="{{ org.facebookUrl }}" target="_blank" rel="noopener me"
                           class="inline-flex items-center gap-2 text-muted-foreground hover:text-workshop-red transition-colors"
                           aria-label="Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.99 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.99 22 12z"/>
                            </svg>
                            <span class="text-sm font-medium">Facebook</span>
                        </a>
                        <p class="text-sm text-muted-foreground mt-2">{{ 'page.facebook_cta'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="mt-8 pt-4 border-t border-muted text-center text-sm text-muted-foreground">
            <p>© {{ "now"|date("Y") }} Warsztatownia Sensoryczna. Wszystkie prawa zastrzeżone.</p>
        </div>
    </div>
</footer>
