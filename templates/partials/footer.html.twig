<footer class="bg-white py-8 border-t border-muted">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div><img src="{{ asset('images/logo-full.webp') }}" alt="Warsztatownia Sensoryczna" class="h-20 w-auto mb-4">
                <p class="text-muted-foreground mb-4">{{ 'page.description'|trans }}</p></div>
            <div><h4 class="font-bold mb-4 text-workshop-brown">{{ 'page.quick_links'|trans }}</h4>
                <ul class="space-y-2">
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('homepage') }}">{{ 'page.homepage'|trans }}</a></li>
                    <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                           href="{{ path('workshops') }}">{{ 'page.workshops'|trans }}</a></li>
                    {% if app.user %}
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ path('dashboard') }}">{{ 'page.my_bookings'|trans }}</a></li>
                    {% else %}
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ path('app_login') }}">{{ 'page.login'|trans }}</a></li>
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ path('user_register') }}">{{ 'page.register'|trans }}</a></li>
                    {% endif %}
                    {% for link in menu_hook_links('footer_links') %}
                        <li><a class="text-muted-foreground hover:text-workshop-red transition-colors"
                               href="{{ link.url }}">{{ link.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div><h4 class="font-bold mb-4 text-workshop-brown">{{ 'page.contact_us'|trans }}</h4>
                <address class="not-italic text-muted-foreground"><p>{{ 'page.default.address.street'|trans }}</p>
                    <p>Radzymin</p>
                    <p class="mt-2">{{ 'page.email'|trans }} {{ 'page.default.email'|trans }}</p>
                    <p>{{ 'page.phone'|trans }} +48 571 531 213</p></address>
            </div>
        </div>
        <div class="mt-8 pt-4 border-t border-muted text-center text-sm text-muted-foreground">
            <p>© {{ "now"|date("Y") }} Warsztatownia Sensoryczna. Wszystkie prawa zastrzeżone.</p>
        </div>
    </div>
</footer>