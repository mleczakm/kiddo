{% extends 'admin/base.html.twig' %}

{% block title %}Treści | Kiddo Admin{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between gap-4">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">CMS</p>
            <h1 class="text-3xl font-black text-slate-900">Artykuły</h1>
        </div>
        <a href="{{ path('app_admin_post_new') }}" class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-700">Nowy artykuł</a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        {% for post in posts %}
            <div class="flex flex-col gap-3 border-b border-slate-100 p-5 last:border-0 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="font-bold text-slate-900">{{ post.body.title }}</p>
                    <p class="text-sm text-slate-500">
                        /{{ post.slug }} ·
                        {% if post.isScheduled %}zaplanowano na {{ post.publishedAt|date('Y-m-d H:i') }}
                        {% else %}{{ post.status.value }}
                        {% endif %}
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_admin_post_edit', {id: post.id}) }}" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold">Edytuj</a>
                    <a href="{{ path('app_admin_post_preview', {id: post.id}) }}" target="_blank" rel="noopener" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold">Podgląd</a>
                    <form method="post" action="{{ path('app_admin_post_toggle', {id: post.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_post_' ~ post.id) }}">
                        <button class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white">{{ post.status.value == 'published' ? 'Cofnij publikację' : 'Opublikuj' }}</button>
                    </form>
                </div>
            </div>
        {% else %}
            <p class="p-8 text-center text-slate-500">Nie ma jeszcze żadnych artykułów.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
