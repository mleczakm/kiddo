{% extends 'admin/base.html.twig' %}

{% block title %}{{ isNew ? 'Nowy artykuł' : 'Edycja artykułu' }} | Kiddo Admin{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl space-y-6" data-controller="post-editor-form">
    <div class="flex items-center justify-between gap-4">
        <div>
            <a href="{{ path('app_admin_posts') }}" class="text-sm font-semibold text-indigo-600">← Artykuły</a>
            <h1 class="mt-2 text-3xl font-black text-slate-900">{{ isNew ? 'Nowy artykuł' : 'Edytuj artykuł' }}</h1>
            {% if not isNew %}
                <p class="mt-1 text-sm text-slate-500">
                    Status:
                    {% if post.isScheduled %}Zaplanowano na {{ post.publishedAt|date('Y-m-d H:i') }}
                    {% elseif post.isPublished %}Opublikowany
                    {% else %}Szkic
                    {% endif %}
                </p>
            {% endif %}
        </div>
        {% if not isNew %}
            <div class="text-right">
                <a href="{{ path('app_admin_post_preview', {id: post.id}) }}" target="_blank" rel="noopener" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold">Podgląd w nowej karcie</a>
                <p data-post-editor-form-target="warning" class="mt-2 hidden text-xs font-semibold text-amber-600">Podgląd pokazuje ostatnio zapisaną wersję — masz niezapisane zmiany.</p>
                <p class="mt-2 text-xs text-slate-400">Podgląd zawsze pokazuje ostatnio zapisaną wersję.</p>
            </div>
        {% endif %}
    </div>

    <form method="post" data-post-editor-form-target="form" class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('edit_post') }}">
        <label class="block"><span class="mb-1 block text-sm font-bold">Tytuł</span><input name="title" required value="{{ post.body.title }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>
        <label class="block"><span class="mb-1 block text-sm font-bold">Etykieta nad tytułem</span><input name="eyebrow" value="{{ post.body.eyebrow }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>
        <label class="block"><span class="mb-1 block text-sm font-bold">Lead</span><textarea name="excerpt" rows="3" class="w-full rounded-xl border border-slate-300 px-4 py-3">{{ post.body.excerpt }}</textarea></label>
        <label class="block">
            <span class="mb-1 block text-sm font-bold">Slug warsztatu</span>
            <input name="linkedWorkshopSlug" list="workshop-slug-options" value="{{ post.body.linkedWorkshopSlug }}" class="w-full rounded-xl border border-slate-300 px-4 py-3">
            <datalist id="workshop-slug-options">
                {% for workshop in workshopOptions %}
                    <option value="{{ workshop.slug }}">{{ workshop.title }}</option>
                {% endfor %}
            </datalist>
        </label>
        <div data-controller="post-tiptap-editor" data-post-tiptap-editor-upload-url="{{ path('app_admin_post_inline_image_upload', {id: post.id}) }}">
            <label class="mb-1 block text-sm font-bold">Treść artykułu</label>

            <div data-post-tiptap-editor-target="toolbar" class="flex flex-wrap items-center gap-1 rounded-t-xl border border-b-0 border-slate-300 bg-slate-50 p-2">
                <button type="button" data-action="post-tiptap-editor#toggleBold" data-format="bold" class="rounded-lg px-2.5 py-1.5 text-sm font-bold hover:bg-slate-200" title="Pogrubienie (Ctrl+B)">B</button>
                <button type="button" data-action="post-tiptap-editor#toggleItalic" data-format="italic" class="rounded-lg px-2.5 py-1.5 text-sm italic hover:bg-slate-200" title="Kursywa (Ctrl+I)">I</button>
                <button type="button" data-action="post-tiptap-editor#toggleUnderline" data-format="underline" class="rounded-lg px-2.5 py-1.5 text-sm underline hover:bg-slate-200" title="Podkreślenie (Ctrl+U)">U</button>
                <button type="button" data-action="post-tiptap-editor#toggleStrike" data-format="strike" class="rounded-lg px-2.5 py-1.5 text-sm line-through hover:bg-slate-200" title="Przekreślenie">S</button>

                <span class="mx-1 h-5 w-px bg-slate-300"></span>

                <button type="button" data-action="post-tiptap-editor#toggleHeading2" data-format="heading2" class="rounded-lg px-2.5 py-1.5 text-sm font-bold hover:bg-slate-200" title="Nagłówek H2">H2</button>
                <button type="button" data-action="post-tiptap-editor#toggleHeading3" data-format="heading3" class="rounded-lg px-2.5 py-1.5 text-sm font-bold hover:bg-slate-200" title="Nagłówek H3">H3</button>

                <span class="mx-1 h-5 w-px bg-slate-300"></span>

                <button type="button" data-action="post-tiptap-editor#toggleBulletList" data-format="bulletList" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Lista punktowana">• Lista</button>
                <button type="button" data-action="post-tiptap-editor#toggleOrderedList" data-format="orderedList" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Lista numerowana">1. Lista</button>
                <button type="button" data-action="post-tiptap-editor#toggleBlockquote" data-format="blockquote" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Cytat">❝ Cytat</button>

                <span class="mx-1 h-5 w-px bg-slate-300"></span>

                <button type="button" data-action="post-tiptap-editor#setLink" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Wstaw link">🔗 Link</button>
                <button type="button" data-action="post-tiptap-editor#insertTable" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Wstaw tabelę">⊞ Tabela</button>
                <button type="button" data-post-tiptap-editor-target="uploadButton" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Wstaw obraz">🖼 Obraz</button>

                <span class="mx-1 h-5 w-px bg-slate-300"></span>

                <button type="button" data-action="post-tiptap-editor#undo" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Cofnij (Ctrl+Z)">↶</button>
                <button type="button" data-action="post-tiptap-editor#redo" class="rounded-lg px-2.5 py-1.5 text-sm hover:bg-slate-200" title="Ponów (Ctrl+Shift+Z)">↷</button>
            </div>

            <div data-post-tiptap-editor-target="editor" class="prose prose-sm min-h-96 w-full rounded-b-xl border border-slate-300 px-4 py-3 shadow-sm focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-200"></div>

            <input type="hidden" name="contentJson" data-post-tiptap-editor-target="contentJson" value="{{ post.body.contentJson|json_encode }}">
            <input type="hidden" name="contentHtml" data-post-tiptap-editor-target="contentHtml" value="{{ post.body.contentHtml }}">
            <input type="file" data-post-tiptap-editor-target="uploadInput" accept="image/jpeg,image/png,image/webp,image/avif" hidden>

            <p class="mt-1 text-xs text-slate-500">H2/H3 nagłówki, listy, tabele, linki, bold/italic/underline/strikethrough, cytaty</p>
        </div>

        <fieldset class="space-y-4 rounded-xl border border-slate-200 p-4">
            <legend class="px-1 text-sm font-bold text-slate-700">Pliki i załączniki</legend>
            <div>
                <label class="block"><span class="mb-1 block text-sm font-bold">Dodaj pliki</span><input type="file" name="files[]" multiple accept="image/jpeg,image/png,image/webp,image/avif,video/mp4,video/webm,video/ogg,application/pdf" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>
                <p class="mt-1 text-xs text-slate-500">Obsługiwane: obrazy (JPEG, PNG, WebP, AVIF), wideo (MP4, WebM, Ogg), dokumenty (PDF)</p>
            </div>
            {% if post.files|length > 0 %}
                <div class="space-y-2">
                    <p class="text-sm font-bold">Obecne pliki</p>
                    {% for file in post.files %}
                        <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
                            <div class="flex-1">
                                <p class="text-sm font-semibold">{{ file.file.originalName }}</p>
                                <p class="text-xs text-slate-500">{{ (file.file.size / 1024)|round(1) }} KB · {{ file.role.value }}</p>
                            </div>
                            <select name="files_role[{{ file.id }}]" class="rounded border border-slate-300 px-2 py-1 text-xs">
                                <option value="cover" {{ file.role.value == 'cover' ? 'selected' : '' }}>Okładka</option>
                                <option value="inline" {{ file.role.value == 'inline' ? 'selected' : '' }}>Wstawić w treść</option>
                                <option value="attachment" {{ file.role.value == 'attachment' ? 'selected' : '' }}>Załącznik</option>
                            </select>
                            <input type="hidden" name="files_id[]" value="{{ file.id }}">
                            <label class="text-xs"><input type="checkbox" name="files_remove[{{ file.id }}]"> Usuń</label>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </fieldset>

        <fieldset class="space-y-4 rounded-xl border border-slate-200 p-4">
            <legend class="px-1 text-sm font-bold text-slate-700">SEO i social media</legend>
            <label class="block"><span class="mb-1 block text-sm font-bold">Tytuł SEO (do 70 znaków)</span><input name="seoTitle" maxlength="70" value="{{ post.seo.seoTitle }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>
            <label class="block"><span class="mb-1 block text-sm font-bold">Opis SEO (do 170 znaków)</span><textarea name="seoDescription" maxlength="170" rows="2" class="w-full rounded-xl border border-slate-300 px-4 py-3">{{ post.seo.seoDescription }}</textarea></label>
            <label class="block"><span class="mb-1 block text-sm font-bold">Adres kanoniczny (https://…)</span><input type="url" name="canonicalUrl" value="{{ post.seo.canonicalUrl }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>
            <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="robotsIndex" value="1" {{ post.seo.shouldRobotsIndex ? 'checked' : '' }}> Indeksuj (robots: index)</label>
                <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="robotsFollow" value="1" {{ post.seo.shouldRobotsFollow ? 'checked' : '' }}> Podążaj za linkami (robots: follow)</label>
            </div>
            <label class="block"><span class="mb-1 block text-sm font-bold">Tytuł social (do 70 znaków)</span><input name="socialTitle" maxlength="70" value="{{ post.seo.socialTitle }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>
            <label class="block"><span class="mb-1 block text-sm font-bold">Opis social (do 200 znaków)</span><textarea name="socialDescription" maxlength="200" rows="2" class="w-full rounded-xl border border-slate-300 px-4 py-3">{{ post.seo.socialDescription }}</textarea></label>
        </fieldset>

        <div class="flex items-center justify-end"><button class="rounded-xl bg-indigo-600 px-6 py-3 font-bold text-white hover:bg-indigo-700">Zapisz szkic</button></div>
    </form>

    {% if not isNew %}
        <form method="post" action="{{ path('app_admin_post_schedule', {id: post.id}) }}" class="flex flex-wrap items-end gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <input type="hidden" name="_token" value="{{ csrf_token('schedule_post_' ~ post.id) }}">
            <label class="block"><span class="mb-1 block text-sm font-bold">Zaplanuj publikację na</span><input type="datetime-local" name="publishedAt" value="{{ post.publishedAt ? post.publishedAt|date('Y-m-d\\TH:i') : '' }}" class="rounded-xl border border-slate-300 px-4 py-3"></label>
            <button class="rounded-xl border border-slate-300 px-6 py-3 font-bold text-slate-700 hover:bg-slate-50">Zaplanuj publikację</button>
        </form>
    {% endif %}
</div>
{% endblock %}
