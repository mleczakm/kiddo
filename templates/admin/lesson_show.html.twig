{% set activeTab = 'lessons' %}
{% set sub_breadcrumbs = [
    {'label': lesson.metadata.title},
    {'label': lesson.schedule|date('Y-m-d H:i')}
] %}
    {# Breadcrumbs #}
    

    {# Header #}
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-2 bg-indigo-500"></div>
        <div class="pl-2">
            <h1 class="text-3xl font-black text-slate-800 flex items-center gap-3">
                {{ lesson.metadata.title }}
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors {{ lesson.status == 'active' ? 'border-transparent bg-green-500 text-white' : 'border-transparent bg-red-500 text-white' }}">
                    {{ lesson.status == 'active' ? ('admin.lessons.status.active'|trans) : ('admin.lessons.status.cancelled'|trans) }}
                </span>
            </h1>
            <p class="text-slate-500 mt-1">
                {{ lesson.schedule|format_datetime('medium', 'short') }} · {{ 'lesson.minutes'|trans({'minutes': lesson.metadata.duration}) }} · {{ lesson.bookings|length }}/{{ lesson.metadata.capacity }}
            </p>
        </div>
        <div class="flex items-center gap-2">
            <form method="post" action="{{ path('app_admin_lesson_toggle', { id: lesson.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle_lesson_' ~ lesson.id) }}">
                <button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-bold border h-10 rounded-xl px-4 transition-colors {{ lesson.status == 'active' ? 'border-red-600 text-red-600 hover:bg-red-50' : 'border-green-600 text-green-600 hover:bg-green-50' }}">
                    {{ lesson.status == 'active' ? ('admin.lessons.actions.deactivate'|trans) : ('admin.lessons.actions.activate'|trans) }}
                </button>
            </form>
            {% if is_granted('LESSON_MANAGE', lesson) %}
                {{ component('WorkshopEditor', { lessonId: lesson.id, startOpen: false }) }}
            {% endif %}
            {% set emails = lesson.attendants|map(u => u.email)|join(',') %}
            <a href="mailto:?bcc={{ emails|url_encode }}" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-bold border h-10 rounded-xl px-4 border-amber-600 text-amber-700 hover:bg-amber-50 transition-colors">
                {{ 'admin.lesson_show.contact_attendees'|trans }}
            </a>
        </div>
    </div>

    {% if holidayNames is not empty %}
        <div role="alert" data-testid="holiday-warning" class="mb-6 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-amber-900 shadow-sm">
            <svg class="mt-0.5 size-5 shrink-0" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.674 1.167-.168 2.625-1.514 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625l6.28-10.875ZM10 6a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6Zm0 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>
            <div>
                <p class="font-bold">{{ 'admin.lesson_show.holiday.title'|trans }}</p>
                <p class="mt-0.5 text-sm">{{ 'admin.lesson_show.holiday.message'|trans({ holidays: holidayNames|join(', ') }) }}</p>
            </div>
        </div>
    {% endif %}

    {# Prev/Next navigation in series #}
    {% if prevLesson or nextLesson %}
        <div class="flex items-center justify-between mb-6">
            <div>
                {% if prevLesson %}
                    <a class="text-sm font-semibold text-indigo-600 hover:underline flex items-center gap-1" href="{{ path('app_admin_lesson_view', { id: prevLesson.id }) }}">
                        ← {{ 'admin.lesson_show.previous_lesson'|trans }} ({{ prevLesson.schedule|date('Y-m-d H:i') }})
                    </a>
                {% endif %}
            </div>
            <div>
                {% if nextLesson %}
                    <a class="text-sm font-semibold text-indigo-600 hover:underline flex items-center gap-1" href="{{ path('app_admin_lesson_view', { id: nextLesson.id }) }}">
                        {{ 'admin.lesson_show.next_lesson'|trans }} ({{ nextLesson.schedule|date('Y-m-d H:i') }}) →
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <section class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="p-6 border-b border-slate-100 bg-slate-50">
                <h2 class="text-xl font-black text-slate-800">{{ 'admin.lesson_show.bookings'|trans }}</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-500 border-b border-slate-100">
                        <tr>
                            <th class="px-6 py-4 font-semibold">{{ 'admin_dashboard.upcoming_lessons.attendees'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin.lesson_show.status'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin.lesson_show.attendance'|trans }}</th>
                            <th class="px-6 py-4 font-semibold">{{ 'admin.lesson_show.notes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for booking in lesson.bookings %}
                            <tr class="cursor-pointer hover:bg-indigo-50/50 transition" data-controller="reservation-modal-trigger" data-action="click->reservation-modal-trigger#open" data-reservation-modal-trigger-booking-id-value="{{ booking.id }}" data-reservation-modal-trigger-lesson-id-value="{{ lesson.id }}">
                                <td class="px-6 py-4">
                                    {% include 'partials/booking_attendee.html.twig' with { booking: booking, show_parent: true } %}
                                </td>
                                <td class="px-6 py-4">
                                    {% set status = booking.status %}
                                    <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold transition-colors
                                        {{ status == 'confirmed' ? 'bg-green-100 text-green-700' : (status == 'cancelled' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-600') }}">
                                        {{ status|trans }}
                                    </span>
                                    {% if booking.isLessonRescheduled(lesson) %}
                                        <span class="ml-2 text-xs font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded">{{ 'admin.lesson_show.rescheduled'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-xs text-slate-400 font-medium">—</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-xs text-slate-600 font-medium">{{ booking.notes ?? '—' }}</span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-slate-400 font-medium">{{ 'admin.lesson_show.no_bookings'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden h-fit">
            <div class="p-6 border-b border-slate-100 bg-slate-50">
                <h2 class="text-xl font-black text-slate-800">{{ 'admin.lesson_show.summary'|trans }}</h2>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-slate-500">{{ 'admin.lesson_show.capacity'|trans }}</span>
                    <span class="text-sm font-black text-slate-800">{{ lesson.metadata.capacity }}</span>
                </div>
                <div class="flex items-center justify-between border-t border-slate-100 pt-3">
                    <span class="text-sm font-semibold text-slate-500">{{ 'admin.lesson_show.booked'|trans }}</span>
                    <span class="text-sm font-black text-slate-800">{{ lesson.bookings|length }}</span>
                </div>
                <div class="flex items-center justify-between border-t border-slate-100 pt-3">
                    <span class="text-sm font-semibold text-slate-500">{{ 'admin.lesson_show.available'|trans }}</span>
                    <span class="text-sm font-black text-green-600">{{ lesson.getAvailableSpots() }}</span>
                </div>
            </div>
        </aside>
    </div>
