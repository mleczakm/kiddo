{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.tabs.schedule'|trans }}{% endblock %}

{% block body %}
    {% if is_granted('ROLE_HOST') %}
        <div class="mb-6">
            {{ component('StaffCalendarSubscription') }}
        </div>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="mb-6">
            {{ component('StaffNotificationPreferences') }}
        </div>
    {% endif %}
    {{ component('AdminScheduleComponent') }}
{% endblock %}
