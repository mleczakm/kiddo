{% extends 'admin/base.html.twig' %}

{% block title %}Menu — linki | Kiddo Admin{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl space-y-6">
    <div>
        <h1 class="text-3xl font-black text-slate-900">Menu — linki</h1>
        <p class="mt-1 text-sm text-slate-500">Dodaj linki do artykułów, warsztatów lub stron zewnętrznych.</p>
    </div>

    <form method="post" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('create_menu_hook') }}">

        <div class="grid gap-4 sm:grid-cols-2">
            <label class="block"><span class="mb-1 block text-sm font-bold">Miejsce w menu</span><select name="slotKey" required class="w-full rounded-xl border border-slate-300 px-4 py-3">
                <option value="">— Wybierz —</option>
                {% for key, label in slots %}
                    <option value="{{ key }}">{{ label }}</option>
                {% endfor %}
            </select></label>

            <label class="block"><span class="mb-1 block text-sm font-bold">Typ linku</span><select name="targetType" required class="w-full rounded-xl border border-slate-300 px-4 py-3">
                <option value="">— Wybierz —</option>
                <option value="post" {{ app.request.query.get('prefillType') == 'post' ? 'selected' : '' }}>Artykuł</option>
                <option value="workshop" {{ app.request.query.get('prefillType') == 'workshop' ? 'selected' : '' }}>Warsztat</option>
                <option value="url" {{ app.request.query.get('prefillType') == 'url' ? 'selected' : '' }}>Adres URL</option>
            </select></label>
        </div>

        <label class="block"><span class="mb-1 block text-sm font-bold">Cel (slug artykułu/warsztatu lub pełny URL)</span><input type="text" name="target" required value="{{ app.request.query.get('prefillTarget') }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>

        <label class="block"><span class="mb-1 block text-sm font-bold">Tekst linku</span><input type="text" name="label" required value="{{ app.request.query.get('prefillLabel') }}" class="w-full rounded-xl border border-slate-300 px-4 py-3"></label>

        <div class="flex justify-end"><button type="submit" class="rounded-xl bg-indigo-600 px-6 py-3 font-bold text-white hover:bg-indigo-700">Dodaj link</button></div>
    </form>

    {% if links %}
        <div class="space-y-4">
            {% set currentSlot = null %}
            {% for link in links %}
                {% if currentSlot != link.slotKey %}
                    {% if currentSlot is not null %}</div>{% endif %}
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                        <h2 class="text-lg font-bold text-slate-900">{{ slots[link.slotKey] }}</h2>
                        <div class="mt-4 space-y-2">
                    {% set currentSlot = link.slotKey %}
                {% endif %}

                <div class="flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <div class="flex-1">
                        <p class="text-sm font-semibold">{{ link.label }}</p>
                        <p class="text-xs text-slate-500">
                            {% if link.targetType.value == 'post' %}
                                Artykuł: {{ link.target }}
                            {% elseif link.targetType.value == 'workshop' %}
                                Warsztat: {{ link.target }}
                            {% else %}
                                URL: {{ link.target }}
                            {% endif %}
                        </p>
                    </div>
                    <form method="post" action="{{ path('app_admin_menu_hook_delete', {id: link.id}) }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_menu_hook_' ~ link.id) }}">
                        <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-700">Usuń</button>
                    </form>
                </div>
            {% endfor %}
            {% if currentSlot is not null %}</div></div>{% endif %}
        </div>
    {% else %}
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
            <p class="text-sm text-slate-600">Brak linków. Dodaj pierwszy link powyżej.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
