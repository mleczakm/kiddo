{% extends 'admin/base.html.twig' %}

{% set sub_breadcrumbs = [{label: article.title}] %}

{% block title %}{{ article.title }} | Pomoc | Kiddo Admin{% endblock %}

{% block body %}
<article class="mx-auto max-w-3xl space-y-6">
    <header class="space-y-2">
        <p class="text-xs font-black uppercase tracking-wider text-slate-400">{{ article.section.label }}</p>
        <h1 class="text-3xl font-black text-slate-900">{{ article.title }}</h1>
        <p class="text-sm text-slate-500">{{ article.summary }}</p>
        {% if article.primaryRoute %}
            <a href="{{ path(article.primaryRoute) }}"
               class="mt-2 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-indigo-700">
                Przejdź do sekcji
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
        {% endif %}
    </header>

    <div class="help-prose rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        {{ include(article.template()) }}
    </div>

    {% if related is not empty %}
        <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <h2 class="mb-3 text-xs font-black uppercase tracking-wider text-slate-400">Powiązane artykuły</h2>
            <ul class="space-y-2">
                {% for item in related %}
                    <li>
                        <a href="{{ path('app_admin_help_article', {slug: item.slug}) }}"
                           class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">{{ item.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <p class="text-xs text-slate-400">Ostatnia aktualizacja: {{ article.updatedAt|format_date(pattern: 'd MMMM yyyy') }}</p>
</article>

{% endblock %}
