{% if isFeatureEnabled('help_center') and is_granted('ROLE_HOST') and app.request.pathInfo starts with '/admin' %}
    <button type="button"
            data-action="help-dialog#open"
            data-help-dialog-url-param="{{ path('app_admin_help_modal', {slug: slug}) }}"
            aria-label="Pomoc: {{ label }}"
            title="Pomoc: {{ label }}"
            class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-slate-300 bg-white text-slate-500 shadow-sm transition hover:border-indigo-400 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
    </button>
{% endif %}
