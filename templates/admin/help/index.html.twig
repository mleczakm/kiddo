{% extends 'admin/base.html.twig' %}

{% block title %}Pomoc i dokumentacja | Kiddo Admin{% endblock %}

{% block body %}
<div class="mx-auto max-w-5xl space-y-6" data-controller="help-filter">
    <div>
        <h1 class="text-3xl font-black text-slate-900">Pomoc i dokumentacja</h1>
        <p class="mt-1 text-sm text-slate-500">
            Opis wszystkich funkcji panelu — z linkami prowadzącymi prosto tam, gdzie wykonasz daną czynność.
            Artykuły znajdziesz też w wyszukiwarce u góry (Ctrl+K).
        </p>
    </div>

    <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        </span>
        <input type="search" placeholder="Filtruj artykuły…" autocomplete="off"
               aria-label="Filtruj artykuły"
               data-help-filter-target="input" data-action="input->help-filter#apply"
               class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>

    {% for group in groups %}
        <section data-help-filter-target="group">
            <h2 class="mb-3 text-xs font-black uppercase tracking-wider text-slate-400">{{ group.section.label }}</h2>
            <div class="grid gap-3 sm:grid-cols-2">
                {% for article in group.articles %}
                    <a href="{{ path('app_admin_help_article', {slug: article.slug}) }}"
                       data-help-filter-target="article"
                       data-help-search="{{ (article.title ~ ' ' ~ article.summary ~ ' ' ~ article.keywords|join(' '))|lower }}"
                       class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-indigo-300 hover:shadow">
                        <span class="font-bold text-slate-900 group-hover:text-indigo-700">{{ article.title }}</span>
                        <span class="mt-1 text-sm text-slate-500">{{ article.summary }}</span>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endfor %}

    <p data-help-filter-target="empty" hidden class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-600">
        Brak artykułów pasujących do filtra.
    </p>
</div>
{% endblock %}
