<dialog data-help-dialog-target="dialog"
        data-action="click->help-dialog#closeFromBackdrop"
        aria-labelledby="context-help-title"
        class="m-auto max-h-[85vh] w-[min(46rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-700 shadow-2xl backdrop:bg-slate-950/60">
    <div class="flex max-h-[85vh] flex-col">
        <header class="flex items-start justify-between gap-4 border-b border-slate-200 bg-slate-50 px-6 py-4">
            <div class="min-w-0">
                <p class="text-[11px] font-black uppercase tracking-wider text-indigo-600">Pomoc kontekstowa</p>
                <h2 id="context-help-title" data-help-dialog-target="title" class="mt-1 text-xl font-black text-slate-900">Pomoc</h2>
            </div>
            <button type="button"
                    data-action="help-dialog#close"
                    aria-label="Zamknij pomoc"
                    class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-xl text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">×</button>
        </header>

        <div class="overflow-y-auto px-6 py-5">
            <div data-help-dialog-target="loading" class="py-12 text-center text-sm font-semibold text-slate-500" role="status">
                Ładowanie pomocy…
            </div>
            <div data-help-dialog-target="content" class="hidden"></div>
            <div data-help-dialog-target="error" class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700" role="alert">
                Nie udało się wczytać pomocy. Spróbuj ponownie lub otwórz panel pomocy z menu.
            </div>
        </div>
    </div>
</dialog>
