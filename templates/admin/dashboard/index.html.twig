{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    {# Platform Billing Component #}
    {% if isFeatureEnabled('platform_billing_widget') %}
        <div class="mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
            {{ component('PlatformBillingComponent') }}
        </div>
    {% endif %}

    {# KPI Statistics #}
    <div data-tour-target="dashboard-kpis">
        {{ component('AdminKpiStatsComponent') }}
    </div>

    {# Dashboard Widgets Grid #}
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
        {# Upcoming Lessons #}
        {{ component('UpcomingLessonsComponent') }}

        {# Upcoming Reservations — quick booking, capacity, payment status #}
        {{ component('UpcomingAttendeesComponent') }}
    </div>

    {# Activity Log #}
    <div class="mt-8">
        {{ component('AdminActivityLogComponent') }}
    </div>
{% endblock %}
