<header class="bg-white h-16 border-b border-slate-200 flex items-center justify-between px-4 md:px-6 shrink-0 z-10 shadow-sm">
    <h1 class="font-bold text-lg text-slate-800 flex items-center gap-2 min-w-0">
        <button type="button"
                class="p-1.5 -ml-1 mr-1 text-slate-500 hover:bg-slate-100 rounded-lg transition md:hidden shrink-0"
                data-action="admin-sidebar#toggle"
                aria-label="{{ 'admin.menu.toggle'|trans }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
        {% if back_url|default(null) %}
            <a href="{{ back_url }}" class="p-1.5 mr-2 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
            </a>
        {% endif %}
        
        {% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}
            {{ 'admin.title'|trans }}
        {% elseif app.request.attributes.get('_route') in ['app_admin_schedule', 'app_admin_lesson_view', 'app_admin_lesson_toggle'] %}
            {{ 'admin.tabs.workshops'|trans }}
        {% elseif app.request.attributes.get('_route') == 'app_admin_transfers' %}
            {{ 'admin.tabs.transfers'|trans }}
        {% elseif app.request.attributes.get('_route') == 'app_admin_bookings' %}
            {{ 'admin.tabs.bookings'|trans }}
        {% elseif app.request.attributes.get('_route') in ['app_admin_users', 'app_admin_user_view'] %}
            {{ 'admin.tabs.users'|trans }}
        {% elseif app.request.attributes.get('_route') == 'app_admin_settings' %}
            {{ 'admin.tabs.settings'|trans }}
        {% else %}
            {{ page_title|default('Kiddo Admin') }}
        {% endif %}
    </h1>

    <div class="flex-1 max-w-xl mx-4 md:mx-8 relative hidden md:block">
        {{ component('AdminGlobalSearchComponent') }}
    </div>

    <div class="flex items-center gap-2 md:gap-4 shrink-0">
        <button type="button"
                class="hidden sm:inline-flex items-center gap-1.5 px-3 h-9 rounded-lg text-sm font-medium text-slate-600 border border-slate-200 hover:bg-slate-50 transition"
                data-action="admin-tour#start">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            {{ 'admin.tour.start_button'|trans }}
        </button>

        {# Notification Bell #}
        <div class="relative" data-tour-target="notif-bell">
            {{ component('NotificationTrayLiveComponent') }}
        </div>
    </div>
</header>
