{% extends 'base.html.twig' %}

{% block title %}{{ 'page.workshops'|trans }} - {{ 'page.default.header'|trans }}{% endblock %}

{% block body %}
    <main class="flex-grow">
        <div class="page-container relative">

            <div class="workshops-hero relative overflow-hidden rounded-3xl mb-12 px-6 py-10 text-center shadow-sm">
                <div class="decorative-orb decorative-orb--hero-left" aria-hidden="true"></div>
                <div class="decorative-orb decorative-orb--hero-right" aria-hidden="true"></div>
                <h1 class="section-title relative mb-3">{{ 'lesson.page.header'|trans }}</h1>
                <p class="relative text-lg text-muted-foreground max-w-2xl mx-auto">{{ 'lesson.page.lead'|trans }}</p>
            </div>
            {{ component('UpcomingLessons', {
                week: week|default(null),
                openSlug: openSlug|default(null),
                openDate: openDate|default(null),
                openHour: openHour|default(null),
            }) }}
        </div>
    </main>
{% endblock %}
