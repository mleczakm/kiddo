{% extends 'base_public_content.html.twig' %}

{% block title %}Blog | Warsztatownia Sensoryczna{% endblock %}

{% block meta %}
    <meta name="description" content="Porady, inspiracje i relacje z warsztatów Warsztatowni Sensorycznej.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="{{ url('posts') }}">
{% endblock %}

{% block body %}
    <main class="px-5 py-14 md:py-20">
        <div class="mx-auto max-w-5xl">
            <a href="{{ path('homepage') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-500 transition-colors hover:text-workshop-red">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                powrót do Warsztatowni
            </a>

            <h1 class="mt-8 text-4xl leading-tight text-workshop-brown md:text-5xl">Blog</h1>
            <p class="mt-4 max-w-2xl text-lg text-stone-600">Porady, inspiracje i relacje z warsztatów.</p>

            {% if featured is not null %}
                {% set cover = featured.coverAttachment %}
                <a href="{{ path('post_by_slug', {slug: featured.slug}) }}" class="mt-12 group grid gap-6 md:grid-cols-2 md:items-center rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-workshop-red/40 hover:shadow-sm md:p-6">
                    {% if cover %}
                        <img src="{{ path('stored_file', {id: cover.file.id, safeName: cover.file.originalName}) }}"
                             alt="{{ cover.altText|default('') }}"
                             class="w-full rounded-xl object-cover"
                             style="aspect-ratio: 16 / 9;"
                             width="1200" height="675">
                    {% endif %}
                    <div>
                        {% if featured.body.eyebrow %}
                            <p class="text-xs font-black uppercase tracking-[0.2em] text-workshop-red">{{ featured.body.eyebrow }}</p>
                        {% endif %}
                        <h2 class="mt-2 text-2xl leading-tight text-workshop-brown transition-colors group-hover:text-workshop-red md:text-3xl">{{ featured.body.title }}</h2>
                        {% if featured.body.excerpt %}
                            <p class="mt-3 text-stone-600">{{ featured.body.excerpt }}</p>
                        {% endif %}
                        <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold text-stone-500">
                            <span>{{ featured.author.name }}</span>
                            <span aria-hidden="true">·</span>
                            <span>{{ featured.publishedAt|format_datetime('medium', 'none', locale: 'pl') }}</span>
                            <span aria-hidden="true">·</span>
                            <span>{{ featured.body.contentHtml|reading_time }} min czytania</span>
                        </div>
                    </div>
                </a>
            {% endif %}

            {% if posts|length > 0 %}
                <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                    {% for post in posts %}
                        {% set cover = post.coverAttachment %}
                        <a href="{{ path('post_by_slug', {slug: post.slug}) }}" class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-workshop-red/40 hover:shadow-sm">
                            {% if cover %}
                                <img src="{{ path('stored_file', {id: cover.file.id, safeName: cover.file.originalName}) }}"
                                     alt="{{ cover.altText|default('') }}"
                                     class="w-full rounded-xl object-cover"
                                     style="aspect-ratio: 16 / 9;"
                                     width="600" height="338">
                            {% endif %}
                            {% if post.body.eyebrow %}
                                <p class="mt-4 text-xs font-black uppercase tracking-[0.2em] text-workshop-red">{{ post.body.eyebrow }}</p>
                            {% endif %}
                            <h2 class="{{ post.body.eyebrow ? 'mt-2' : 'mt-4' }} text-xl leading-tight text-workshop-brown transition-colors group-hover:text-workshop-red">{{ post.body.title }}</h2>
                            {% if post.body.excerpt %}
                                <p class="mt-2 line-clamp-3 text-sm text-stone-600">{{ post.body.excerpt }}</p>
                            {% endif %}
                            <div class="mt-auto pt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-stone-500">
                                <span>{{ post.publishedAt|format_datetime('medium', 'none', locale: 'pl') }}</span>
                                <span aria-hidden="true">·</span>
                                <span>{{ post.body.contentHtml|reading_time }} min czytania</span>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% elseif featured is null %}
                <p class="mt-12 text-stone-500">Nie ma jeszcze żadnych artykułów.</p>
            {% endif %}

            {% if lastPage > 1 %}
                <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Nawigacja stron">
                    {% if page > 1 %}
                        <a href="{{ path('posts', {page: page - 1}) }}" class="rounded-lg border border-stone-200 px-4 py-2 text-sm font-semibold text-workshop-brown transition hover:border-workshop-red/40">Poprzednia</a>
                    {% endif %}
                    <span class="px-4 py-2 text-sm font-semibold text-stone-500">Strona {{ page }} z {{ lastPage }}</span>
                    {% if page < lastPage %}
                        <a href="{{ path('posts', {page: page + 1}) }}" class="rounded-lg border border-stone-200 px-4 py-2 text-sm font-semibold text-workshop-brown transition hover:border-workshop-red/40">Następna</a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    </main>
{% endblock %}
